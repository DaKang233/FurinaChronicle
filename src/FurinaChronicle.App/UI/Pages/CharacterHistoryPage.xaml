<ContentPage
    x:Class="FurinaChronicle.App.UI.Pages.CharacterHistoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:FurinaChronicle.App.UI.Pages"
    xmlns:history="clr-namespace:FurinaChronicle.Presentation.History;assembly=FurinaChronicle.Presentation"
    SafeAreaEdges="All"
    Title="角色与武器">
    <Grid>
    <Grid Padding="16" RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <VerticalStackLayout x:Name="Filters" Spacing="8">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Picker x:Name="ArchivePicker" Title="档案"
                        SelectedIndexChanged="OnArchiveChanged"
                        AutomationId="CharacterArchivePicker" />
                <Picker x:Name="AccountPicker" Grid.Column="1" Title="账号"
                        SelectedIndexChanged="OnAccountChanged"
                        AutomationId="CharacterAccountPicker" />
            </Grid>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                <Button x:Name="RefreshButton" Text="采集最新" FontSize="13"
                        Clicked="OnRefreshClicked" AutomationId="RefreshCharacterCollection" />
                <Button x:Name="CompareButton" Grid.Column="1" Text="比较快照" FontSize="13"
                        Clicked="OnCompareClicked" AutomationId="CompareCharacterObservations" />
                <Button x:Name="ValidateButton" Grid.Column="2" Text="隔离验证" FontSize="13"
                        Clicked="OnValidateClicked" AutomationId="ValidateCharacterCollection" />
            </Grid>
            <Label x:Name="StatusLabel" AutomationId="CharacterCollectionStatus" />
            <Grid ColumnDefinitions="*,2*" ColumnSpacing="8">
                <Picker x:Name="KindPicker" Title="类型"
                        SelectedIndexChanged="OnKindChanged" AutomationId="CharacterKindPicker" />
                <Picker x:Name="ObservationPicker" Grid.Column="1" Title="历史观察"
                        SelectedIndexChanged="OnObservationChanged" AutomationId="CharacterObservationPicker" />
            </Grid>
            <Label x:Name="ObservationDetailLabel" AutomationId="CharacterObservationDetail" />
            <Picker x:Name="ProfilePicker" Title="选择角色" IsVisible="False"
                    SelectedIndexChanged="OnProfileChanged" AutomationId="CharacterProfilePicker" />
        </VerticalStackLayout>

        <CollectionView x:Name="HistoryList" Grid.Row="1" SelectionMode="None"
                        AutomationId="CharacterObservationList">
            <CollectionView.EmptyView>
                <Label Text="此账号暂无已保存的角色或武器观察。" Margin="0,8" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="history:CharacterObservationCard">
                    <Border Padding="12" Margin="0,0,0,8" StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="18" />
                            <Label Text="{Binding Evidence}" />
                            <Label Text="{Binding Detail}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ScrollView x:Name="ProfileScroll" Grid.Row="1" IsVisible="False">
            <VerticalStackLayout x:Name="ProfileContent" Spacing="10" />
        </ScrollView>

        <Grid x:Name="Paging" Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Button x:Name="PreviousButton" Text="上一页" Clicked="OnPreviousClicked" />
            <Label x:Name="PageLabel" Grid.Column="1" HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center" />
            <Button x:Name="NextButton" Grid.Column="2" Text="下一页" Clicked="OnNextClicked" />
        </Grid>
    </Grid>
    <Grid x:Name="CharacterOverlay" IsVisible="False"
          BackgroundColor="#99000000" RowDefinitions="1*,9*">
        <Border x:Name="CharacterSheet" Grid.Row="1" Padding="16,10,16,12"
                StrokeThickness="0" StrokeShape="RoundRectangle 20,20,0,0"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#22252C}">
            <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,Auto" RowSpacing="10">
                <Label x:Name="CharacterSheetTitle" VerticalOptions="Center"
                       FontSize="20" FontAttributes="Bold" />
                <Button Grid.Column="1" Text="×" Clicked="OnCloseCharacterSheet"
                        SemanticProperties.Description="关闭详情" AutomationId="CloseCharacterSheet" />
                <ScrollView Grid.Row="1" Grid.ColumnSpan="2" x:Name="CharacterSheetScroll">
                    <VerticalStackLayout x:Name="CharacterSheetContent" Spacing="10" />
                </ScrollView>
            </Grid>
        </Border>
    </Grid>
    </Grid>
</ContentPage>
