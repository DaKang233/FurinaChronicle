<ContentView
    x:Class="FurinaChronicle.App.UI.Gacha.CalendarView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:FurinaChronicle.App.ViewModels"
    x:DataType="viewModels:GachaAnalysisViewModel">
    <VerticalStackLayout Spacing="10" Padding="0,8">
        <Label FontAttributes="Bold" FontSize="20" Text="抽卡日历" />
        <HorizontalStackLayout Spacing="8">
            <Button x:Name="PreviousYear" Text="上一年" Clicked="OnPreviousYear" IsEnabled="{Binding IsNotBusy}" />
            <Picker x:Name="YearPicker" Title="年份" WidthRequest="110"
                    SelectedIndexChanged="OnYearChanged" IsEnabled="{Binding IsNotBusy}" />
            <Button x:Name="NextYear" Text="下一年" Clicked="OnNextYear" IsEnabled="{Binding IsNotBusy}" />
        </HorizontalStackLayout>
        <Label x:Name="YearSummary" FontSize="12" />
        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Always">
            <Grid x:Name="HeatmapGrid" ColumnSpacing="3" RowSpacing="3" Padding="0,4"
                  HorizontalOptions="Start" AutomationId="GachaCalendarHeatmap" />
        </ScrollView>
        <HorizontalStackLayout x:Name="Legend" Spacing="4" />
        <Label FontSize="11" Text="每列一周、周一至周日从上到下排列。点击方格查看当天统计。按 UTC+08:00 分日，仅统计本地记录。" />
        <Label x:Name="SelectedDay" FontSize="13" />
    </VerticalStackLayout>
</ContentView>
