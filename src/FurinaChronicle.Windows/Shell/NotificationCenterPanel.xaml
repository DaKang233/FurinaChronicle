<UserControl
    x:Class="FurinaChronicle.Windows.Shell.NotificationCenterPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    KeyDown="OnKeyDown"
    AutomationProperties.AutomationId="Ui7NotificationCenterPanel">
    <Grid>
        <Border
            x:Name="PanelCard"
            AutomationProperties.AutomationId="Ui7NotificationPanelCard"
            HorizontalAlignment="Right"
            Width="380"
            MaxHeight="480"
            CornerRadius="10"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}">
            <Grid RowSpacing="8" Padding="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="通知中心" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="UnreadText"
                            FontSize="12"
                            VerticalAlignment="Center"
                            AutomationProperties.LiveSetting="Polite"
                            AutomationProperties.AutomationId="Ui7UnreadText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Content="&#xE70E;"
                        FontFamily="Segoe Fluent Icons"
                        Click="OnCollapseClicked"
                        Padding="6"
                        ToolTipService.ToolTip="收起通知中心"
                        AutomationProperties.Name="收起通知中心"
                        AutomationProperties.AutomationId="Ui7CollapseNotifications" />
                </Grid>

                <ScrollViewer
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    MaxHeight="320">
                    <ListView
                        x:Name="NotificationList"
                        SelectionMode="None"
                        AutomationProperties.AutomationId="Ui7NotificationList">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Padding="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Glyph="{Binding Glyph}"
                                        Foreground="{Binding Accent}"
                                        FontSize="16"
                                        VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse
                                                Width="6"
                                                Height="6"
                                                Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                Visibility="{Binding UnreadVisibility}"
                                                VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock
                                                Text="{Binding TimeText}"
                                                FontSize="11"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock
                                                Text="{Binding RepeatText}"
                                                FontSize="11"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock
                                                Text="{Binding ProgressText}"
                                                FontSize="11"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding ProgressVisibility}"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock
                                            Text="{Binding Message}"
                                            TextWrapping="Wrap"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock
                                            Text="{Binding DiagnosticText}"
                                            FontSize="11"
                                            Visibility="{Binding DiagnosticVisibility}"
                                            FontFamily="Consolas"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock
                                            Text="{Binding CategoryText}"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                                        <Button
                                            Content="{Binding ActionLabel}"
                                            Visibility="{Binding ActionVisibility}"
                                            Tag="{Binding}"
                                            Click="OnActionClicked"
                                            Padding="6,2"
                                            FontSize="11"
                                            AutomationProperties.Name="执行通知操作" />
                                        <Button
                                            Content="&#xE711;"
                                            FontFamily="Segoe Fluent Icons"
                                            Tag="{Binding Id}"
                                            Click="OnDismissClicked"
                                            Padding="6"
                                            AutomationProperties.Name="移除通知" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="MarkAllReadButton"
                        Content="全部已读"
                        Click="OnMarkAllReadClicked"
                        FontSize="12"
                        AutomationProperties.AutomationId="Ui7MarkAllRead" />
                    <Button
                        x:Name="ClearButton"
                        Content="清空"
                        Click="OnClearClicked"
                        FontSize="12"
                        AutomationProperties.AutomationId="Ui7ClearNotifications" />
                    <Button
                        x:Name="ExportDiagnosticsButton"
                        Content="导出诊断"
                        Click="OnExportDiagnosticsClicked"
                        FontSize="12"
                        ToolTipService.ToolTip="保存本地诊断报告"
                        AutomationProperties.Name="导出本地诊断报告"
                        AutomationProperties.AutomationId="Ui7ExportDiagnostics" />
                </StackPanel>
            </Grid>
        </Border>

        <Button
            x:Name="OpenButton"
            Width="52"
            Height="52"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            CornerRadius="26"
            Visibility="Collapsed"
            Click="OnOpenClicked"
            Background="{ThemeResource AccentFillColorDefaultBrush}"
            ToolTipService.ToolTip="通知中心"
            AutomationProperties.Name="打开通知中心"
            AutomationProperties.AutomationId="Ui7NotificationBell">
            <Grid>
                <FontIcon Glyph="&#xEA8F;" FontSize="20" Foreground="White" />
                <Border
                    x:Name="BellBadge"
                    MinWidth="18"
                    Height="18"
                    CornerRadius="9"
                    Background="{ThemeResource SystemFillColorCriticalBrush}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="BellBadgeText"
                        FontSize="10"
                        Foreground="White"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="4,0" />
                </Border>
            </Grid>
        </Button>
    </Grid>
</UserControl>
