<UserControl
    x:Class="FurinaChronicle.Windows.Pages.ChallengePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="Ui5ChallengePage">
    <Grid Padding="24,16,24,16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock Text="周期挑战" FontSize="28" FontWeight="SemiBold" />
            <TextBlock
                Text="查看深境螺旋、幻想真境剧诗与幽境危战的挑战观察。"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
            <Button
                x:Name="CollectButton"
                Content="采集最新记录"
                Click="OnCollect"
                AutomationProperties.Name="采集当前模式最新挑战记录"
                AutomationProperties.AutomationId="ChallengePageCollect" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="6">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    x:Name="ArchivePicker"
                    Header="档案"
                    DisplayMemberPath="Label"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="档案"
                    AutomationProperties.AutomationId="Ui5ChallengeArchivePicker" />
                <ComboBox
                    x:Name="AccountPicker"
                    Grid.Column="1"
                    Header="账号"
                    DisplayMemberPath="Label"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="账号"
                    AutomationProperties.AutomationId="Ui5ChallengeAccountPicker" />
                <ComboBox
                    x:Name="ModePicker"
                    Grid.Column="2"
                    Header="模式"
                    MinWidth="150"
                    AutomationProperties.Name="模式"
                    AutomationProperties.AutomationId="Ui5ChallengeModePicker" />
                <ComboBox
                    x:Name="SeasonPicker"
                    Grid.Column="3"
                    Header="期次"
                    MinWidth="130"
                    AutomationProperties.Name="期次"
                    AutomationProperties.AutomationId="Ui5ChallengeSeasonPicker" />
            </Grid>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="ReloadButton"
                    Content="刷新"
                    Click="OnReload"
                    AutomationProperties.Name="刷新周期挑战观察"
                    AutomationProperties.AutomationId="Ui5ChallengeReload" />
                <Button
                    x:Name="PreviousButton"
                    Grid.Column="1"
                    Content="上一页"
                    Click="OnPrevious"
                    AutomationProperties.Name="上一页观察"
                    AutomationProperties.AutomationId="Ui5ChallengePrevious" />
                <Button
                    x:Name="NextButton"
                    Grid.Column="2"
                    Content="下一页"
                    Click="OnNext"
                    AutomationProperties.Name="下一页观察"
                    AutomationProperties.AutomationId="Ui5ChallengeNext" />
                <ProgressRing
                    x:Name="LoadingRing"
                    Grid.Column="3"
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    IsActive="False"
                    Visibility="Collapsed"
                    AutomationProperties.AutomationId="Ui5ChallengeLoading" />
                <TextBlock
                    x:Name="PageText"
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    AutomationProperties.AutomationId="Ui5ChallengePaging" />
            </Grid>
        </StackPanel>

        <TextBlock
            x:Name="EmptyText"
            Grid.Row="2"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed"
            AutomationProperties.AutomationId="Ui5ChallengeEmpty" />

        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <ListView
                x:Name="ObservationList"
                SelectionMode="Single"
                AutomationProperties.Name="挑战观察"
                AutomationProperties.AutomationId="Ui5ChallengeObservationList">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="8,6" Spacing="2">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock
                                Text="{Binding OccurredText}"
                                FontSize="12"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Name="DetailTitleText"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap"
                    AutomationProperties.AutomationId="Ui5ChallengeDetailTitle" />
                <ScrollViewer Grid.Row="1">
                    <TextBlock
                        x:Name="DetailBodyText"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"
                        AutomationProperties.AutomationId="Ui5ChallengeDetail" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
