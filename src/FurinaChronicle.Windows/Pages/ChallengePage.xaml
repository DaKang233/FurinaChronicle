<UserControl x:Class="FurinaChronicle.Windows.Pages.ChallengePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="Ui5ChallengePage">
    <Grid Padding="20,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Image Source="ms-appx:///Assets/Challenge/Navigation/HardChallenge.png" Width="28" Height="28" />
                <TextBlock Text="周期挑战" FontSize="26" FontWeight="SemiBold" />
            </StackPanel>
            <Button x:Name="CollectButton" Grid.Column="1" Content="采集最新记录" Click="OnCollect"
                AutomationProperties.Name="采集当前模式最新挑战记录" AutomationProperties.AutomationId="ChallengePageCollect" />
            <Button x:Name="ReloadButton" Grid.Column="2" Content="重新载入" Click="OnReload"
                AutomationProperties.Name="刷新周期挑战观察" AutomationProperties.AutomationId="Ui5ChallengeReload" />
        </Grid>
        <Grid x:Name="SelectorPanel" Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ComboBox x:Name="ArchivePicker" Header="档案" DisplayMemberPath="Label" HorizontalAlignment="Stretch"
                SelectionChanged="OnArchiveSelectionChanged" AutomationProperties.AutomationId="Ui5ChallengeArchivePicker" />
            <ComboBox x:Name="AccountPicker" Grid.Column="1" Header="账号" DisplayMemberPath="Label" HorizontalAlignment="Stretch"
                SelectionChanged="OnAccountSelectionChanged" AutomationProperties.AutomationId="Ui5ChallengeAccountPicker" />
            <ComboBox x:Name="ModePicker" Grid.Column="2" Header="模式" MinWidth="160"
                SelectionChanged="OnModeSelectionChanged" AutomationProperties.AutomationId="Ui5ChallengeModePicker" />
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <ProgressRing x:Name="LoadingRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
            <TextBlock x:Name="EmptyText" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.AutomationId="Ui5ChallengeEmpty" />
        </StackPanel>
        <Grid Grid.Row="3" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid RowSpacing="6">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="挑战期次" FontWeight="SemiBold" />
                <ListView x:Name="SeasonList" Grid.Row="1" SelectionChanged="OnSeasonSelectionChanged"
                    AutomationProperties.Name="挑战期次" AutomationProperties.AutomationId="Ui5ChallengeSeasonList">
                    <ListView.ItemTemplate><DataTemplate><StackPanel Spacing="4" Padding="2,8">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Period}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel></DataTemplate></ListView.ItemTemplate>
                </ListView>
            </Grid>
            <Grid Grid.Column="1" RowSpacing="6">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="采集快照" FontWeight="SemiBold" />
                <ListView x:Name="ObservationList" Grid.Row="1" SelectionChanged="OnObservationSelectionChanged"
                    AutomationProperties.Name="采集快照" AutomationProperties.AutomationId="Ui5ChallengeObservationList">
                    <ListView.ItemTemplate><DataTemplate><StackPanel Padding="2,8" Spacing="4">
                        <TextBlock Text="{Binding CollectionTimeText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CompletenessText}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel></DataTemplate></ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="PageText" Grid.Row="2" FontSize="11" TextWrapping="Wrap" AutomationProperties.AutomationId="Ui5ChallengePaging" />
                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="4">
                    <Button x:Name="PreviousButton" Content="上一页" Padding="7,4" Click="OnPrevious" AutomationProperties.AutomationId="Ui5ChallengePrevious" />
                    <Button x:Name="NextButton" Content="下一页" Padding="7,4" Click="OnNext" AutomationProperties.AutomationId="Ui5ChallengeNext" />
                </StackPanel>
            </Grid>
            <Grid Grid.Column="2" RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="DetailTitleText" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="Ui5ChallengeDetailTitle" />
                        <TextBlock x:Name="PeriodText" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="StatisticsButton" Grid.Column="1" Content="统计数据" Click="OnStatistics" Visibility="Collapsed"
                        AutomationProperties.AutomationId="ChallengeStatistics" />
                </Grid>
                <ListView x:Name="FloorTabs" Grid.Row="1" SelectionChanged="OnFloorChanged" SelectionMode="Single"
                    Visibility="Collapsed" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    AutomationProperties.Name="深境螺旋楼层" AutomationProperties.AutomationId="ChallengeFloorTabs">
                    <ListView.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListView.ItemsPanel>
                    <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" Padding="8,4" /></DataTemplate></ListView.ItemTemplate>
                </ListView>
                <ComboBox x:Name="RunPicker" Grid.Row="2" Visibility="Collapsed" SelectionChanged="OnRunChanged"
                    AutomationProperties.Name="单人或联机挑战" AutomationProperties.AutomationId="ChallengeRunPicker">
                    <x:String>单人挑战</x:String><x:String>联机挑战</x:String>
                </ComboBox>
                <ScrollViewer x:Name="DetailScroll" Grid.Row="3" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <StackPanel x:Name="DetailContent" Spacing="10" AutomationProperties.Name="挑战关卡详情" AutomationProperties.AutomationId="Ui5ChallengeDetail" />
                        <Expander Header="来源与采集说明" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <TextBlock x:Name="DetailBodyText" FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
