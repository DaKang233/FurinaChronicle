<UserControl x:Class="FurinaChronicle.Windows.Pages.AiPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Padding="24" Spacing="12">
   <TextBlock Text="AI 分析" FontSize="28" FontWeight="SemiBold" />
   <TextBlock Text="围绕所选本地资料分析和追问。发送前可查看完整正文；模型结果不会写回档案事实。" TextWrapping="Wrap" />
   <Expander x:Name="ServiceExpander" Header="模型服务" IsExpanded="True" HorizontalAlignment="Stretch">
    <StackPanel Spacing="8" HorizontalAlignment="Stretch" x:Name="ServiceInputs">
     <ComboBox x:Name="ProtocolInput" Header="接口类型" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="AiProtocol" />
     <TextBox x:Name="AddressInput" Header="服务 API 基址" PlaceholderText="https://服务地址/v1" AutomationProperties.AutomationId="AiBaseAddress" />
     <TextBox x:Name="ModelInput" Header="模型名称" AutomationProperties.AutomationId="AiModel" />
     <PasswordBox x:Name="KeyInput" Header="API 密钥（留空保留此服务已有密钥）" AutomationProperties.AutomationId="AiApiKey" />
     <StackPanel Orientation="Horizontal" Spacing="8">
      <NumberBox x:Name="BudgetInput" Header="资料上限（字符，不是 token）" Minimum="4000" Maximum="1000000" SmallChange="1000" Value="24000" Width="240" />
      <NumberBox x:Name="OutputInput" Header="输出上限（token）" Minimum="128" Maximum="8192" Value="2048" Width="180" />
     </StackPanel>
     <CheckBox x:Name="DisableThinkingInput" Content="关闭兼容服务的思考模式（DeepSeek 等支持 thinking 参数的服务；其他服务请勿勾选）" />
     <StackPanel x:Name="OllamaInputs" Orientation="Horizontal" Spacing="12">
      <NumberBox x:Name="ContextInput" Header="Ollama 上下文（token）" Minimum="2048" Maximum="131072" Value="4096" Width="240" />
      <CheckBox x:Name="CpuInput" Content="仅 CPU（节省显存）" />
     </StackPanel>
     <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="SaveButton" Content="保存配置与密钥" Click="OnSaveSettings" AutomationProperties.AutomationId="AiSaveSettings" />
      <Button x:Name="ModelsButton" Content="查看模型（不发送档案）" Click="OnModels" />
      <Button x:Name="ClearKeyButton" Content="移除此服务密钥" Click="OnClearKey" />
     </StackPanel>
    </StackPanel>
   </Expander>
   <Grid ColumnSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <ComboBox x:Name="ArchiveInput" Header="档案" DisplayMemberPath="Label" SelectionChanged="OnArchiveChanged" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="AiArchive" />
    <ComboBox x:Name="AccountInput" Header="分析范围" DisplayMemberPath="Label" Grid.Column="1" SelectionChanged="OnAccountChanged" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="AiAccount" />
   </Grid>
   <StackPanel Orientation="Horizontal" Spacing="8">
    <TextBox x:Name="FromInput" Header="UTC 起始日期（可留空）" PlaceholderText="YYYY-MM-DD" Width="220" TextChanged="OnScopeEdited" />
    <TextBox x:Name="ToInput" Header="UTC 结束日期（含当日）" PlaceholderText="YYYY-MM-DD" Width="220" TextChanged="OnScopeEdited" />
   </StackPanel>
   <StackPanel Orientation="Horizontal" Spacing="12">
    <CheckBox x:Name="GachaInput" Content="抽卡统计与记录" IsChecked="True" Click="OnScopeClicked" />
    <CheckBox x:Name="ItemsInput" Content="角色与武器历程" IsChecked="True" Click="OnScopeClicked" />
    <CheckBox x:Name="ChallengesInput" Content="周期挑战" IsChecked="True" Click="OnScopeClicked" />
    <CheckBox x:Name="ChronicleInput" Content="游戏历程节点" IsChecked="True" Click="OnScopeClicked" />
   </StackPanel>
   <CheckBox x:Name="UidInput" Content="档案分析默认携带 UID 区分账号（发送前必须明确同意；也可改用按 UID 升序编号）" IsChecked="True" Click="OnScopeClicked" AutomationProperties.AutomationId="AiArchiveUids" />
   <TextBlock Text="单账号分析始终不发送 UID。昵称、档案名、备注与凭据不进入资料；问题中的长号码会隐藏。" TextWrapping="Wrap" />
   <StackPanel Orientation="Horizontal" Spacing="8">
    <Button x:Name="PrepareButton" Content="准备本次资料" Click="OnPrepare" AutomationProperties.AutomationId="AiPrepare" />
    <Button x:Name="PreviewButton" Content="查看资料与证据" Click="OnPreview" />
    <Button x:Name="CancelButton" Content="取消" Click="OnCancel" AutomationProperties.AutomationId="AiCancel" />
   </StackPanel>
   <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.AutomationId="AiStatus" />
   <TextBox x:Name="QuestionInput" Header="分析问题／继续追问" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="160" PlaceholderText="例如：分析抽卡效率、养成变化和挑战历程，并说明记录有哪些缺口。" AutomationProperties.AutomationId="AiQuestion" />
   <StackPanel Orientation="Horizontal" Spacing="8">
    <Button x:Name="SendButton" Content="审查并发送" Click="OnSend" AutomationProperties.AutomationId="AiSend" />
    <Button x:Name="ExportButton" Content="导出 Markdown 报告" Click="OnExport" />
   </StackPanel>
   <TextBox x:Name="ReplyText" Header="模型分析（请结合证据复核）" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" MaxHeight="480" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="AiReply" />
   <TextBlock Text="本次资料的本地证据" FontWeight="SemiBold" />
   <ListView x:Name="EvidenceList" DisplayMemberPath="DisplayLabel" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnEvidence" MaxHeight="220" AutomationProperties.AutomationId="AiEvidence" />
  </StackPanel>
 </ScrollViewer>
</UserControl>
