<UserControl x:Class="FurinaChronicle.Windows.Pages.AiPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Padding="16" ColumnSpacing="16">
  <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid RowSpacing="8">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Button Content="＋ 新对话" Click="OnNew" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="AiNewChat" />
   <TextBox x:Name="SearchInput" Grid.Row="1" PlaceholderText="搜索标题或本地 UID" TextChanged="OnSearch" AutomationProperties.AutomationId="AiSearch" />
   <ListView x:Name="ChatList" Grid.Row="2" DisplayMemberPath="Label" SelectionChanged="OnChatSelected" AutomationProperties.AutomationId="AiConversations" />
  </Grid>
  <Grid Grid.Column="1" RowSpacing="8">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="ModelText" Opacity="0.7"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
     <Button Content="重命名" Click="OnRename"/><Button Content="置顶/取消" Click="OnPin"/><Button Content="删除" Click="OnDelete"/><Button Content="设置" Click="OnSettings" AutomationProperties.AutomationId="AiOpenSettings"/>
    </StackPanel>
   </Grid>
   <TextBlock x:Name="StatusText" Grid.Row="1" TextWrapping="Wrap" AutomationProperties.AutomationId="AiStatus"/>
   <ScrollViewer x:Name="MessagesScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" ViewChanged="OnScrollChanged" AutomationProperties.AutomationId="AiMessages">
    <StackPanel x:Name="MessagesPanel" Spacing="16" Padding="0,8"/>
   </ScrollViewer>
   <StackPanel Grid.Row="3" Spacing="4">
    <TextBlock x:Name="ContextText" TextWrapping="Wrap"/>
    <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="AttachmentsPanel" Spacing="4"/></ScrollViewer>
    <CheckBox x:Name="ImageConsent" Content="已检查图片内容，并已移除 UID、凭据和个人标识" Click="OnImageConsent" Visibility="Collapsed" />
   </StackPanel>
   <TextBox x:Name="QuestionInput" Grid.Row="4" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="74" MaxHeight="160" PlaceholderText="发送消息；Shift+Enter 换行。可附加文件或档案资料。" TextChanged="OnDraftChanged" KeyDown="OnComposerKey" AutomationProperties.AutomationId="AiQuestion"/>
   <Grid Grid.Row="5" ColumnSpacing="8" RowSpacing="6">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Spacing="6">
     <Button x:Name="FileButton" Content="文件/图片" Click="OnFile" AutomationProperties.AutomationId="AiAttachFile"/>
     <Button x:Name="DataButton" Content="档案资料" Click="OnData" AutomationProperties.AutomationId="AiPrepare"/>
     <Button Content="资料/证据" Click="OnEvidence"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6"><Button Content="导出" Click="OnExport"/><Button Content="↓ 回到底部" Click="OnBottom"/></StackPanel>
    <Button x:Name="SendButton" Grid.Column="1" Content="发送" Click="OnSend" AutomationProperties.AutomationId="AiSend"/>
    <Button x:Name="CancelButton" Grid.Column="1" Grid.Row="1" Content="停止" Click="OnStop" AutomationProperties.AutomationId="AiCancel"/>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
