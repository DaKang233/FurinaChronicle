<UserControl
    x:Class="FurinaChronicle.Windows.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="Ui4SettingsPage">
    <ScrollViewer Padding="24">
        <StackPanel x:Name="SettingsSections" MaxWidth="1000" HorizontalAlignment="Left" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold" />
                <TextBlock
                    Text="管理外观、AI 服务、存储与诊断。"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border Padding="16" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="AI" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="管理供应商、模型、服务密钥与模型参数。"
                            FontSize="12" TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button x:Name="AiSettingsButton" Grid.Column="1" Content="AI 设置"
                        VerticalAlignment="Center" Click="OnOpenAiSettings"
                        AutomationProperties.AutomationId="AiSettingsEntry" />
                </Grid>
            </Border>

            <Border Padding="16" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="2">
                    <TextBlock Text="外观" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid ColumnSpacing="16" Padding="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="主题" FontSize="14" />
                            <TextBlock Text="跟随系统、浅色或深色。"
                                FontSize="12" TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox
                            x:Name="ThemePicker"
                            Grid.Column="1"
                            Width="160"
                            VerticalAlignment="Center"
                            SelectionChanged="OnThemeSelectionChanged"
                            AutomationProperties.Name="主题"
                            AutomationProperties.AutomationId="Ui4SettingsTheme" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Padding="16" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="2">
                    <TextBlock Text="数据与存储" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid ColumnSpacing="16" Padding="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="图标缓存" FontSize="14" />
                            <TextBlock Text="清除可重建的图标；不影响档案、账号与抽卡记录。"
                                FontSize="12" TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center">
                            <TextBlock x:Name="CacheSizeText" VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                AutomationProperties.AutomationId="Ui4SettingsCacheSize" />
                            <Button x:Name="ClearIconCacheButton" Content="清除图标缓存"
                                Click="OnClearIconCache"
                                AutomationProperties.AutomationId="Ui4SettingsClearIconCache" />
                        </StackPanel>
                    </Grid>
                    <Expander Header="存储位置" HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="Ui4SettingsStorageDetails">
                        <StackPanel Spacing="8" Padding="0,8,0,0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="数据目录" FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="DataRootText" TextWrapping="Wrap" FontSize="12"
                                    AutomationProperties.AutomationId="Ui4SettingsDataRoot" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Text="数据库" FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="DatabasePathText" TextWrapping="Wrap" FontSize="12"
                                    AutomationProperties.AutomationId="Ui4SettingsDatabasePath" />
                                <TextBlock x:Name="DatabaseSizeText" FontSize="12"
                                    AutomationProperties.AutomationId="Ui4SettingsDatabaseSize" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Text="图标缓存目录" FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="CachePathText" TextWrapping="Wrap" FontSize="12"
                                    AutomationProperties.AutomationId="Ui4SettingsCachePath" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <Border Padding="16" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="2">
                    <TextBlock Text="历史" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid ColumnSpacing="16" Padding="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="撤销保留次数" FontSize="14" />
                            <TextBlock Text="0～1000；0 会关闭撤销资格。"
                                FontSize="12" TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <NumberBox
                                    x:Name="UndoLimitBox"
                                    Minimum="0"
                                    Maximum="1000"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Compact"
                                    Width="140"
                                    AutomationProperties.Name="撤销保留次数"
                                    AutomationProperties.AutomationId="Ui4SettingsUndoLimit" />
                                <Button x:Name="ApplyUndoLimitButton" Content="应用"
                                    Click="OnApplyUndoLimit"
                                    AutomationProperties.AutomationId="Ui4SettingsApplyUndoLimit" />
                            </StackPanel>
                            <TextBlock x:Name="UndoLimitValidation" Visibility="Collapsed"
                                FontSize="12" TextWrapping="Wrap"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                AutomationProperties.AutomationId="Ui4SettingsUndoLimitValidation" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="16" Padding="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="历史档案" FontSize="14" />
                            <TextBlock Text="选择一个档案查看或修改其撤销限额。"
                                FontSize="12" TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox
                            x:Name="HistoryArchivePicker"
                            Grid.Column="1"
                            Width="220"
                            VerticalAlignment="Center"
                            DisplayMemberPath="Name"
                            SelectionChanged="OnHistoryArchiveSelectionChanged"
                            AutomationProperties.Name="历史档案"
                            AutomationProperties.AutomationId="Ui4SettingsHistoryArchive" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Padding="16" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="2">
                    <TextBlock Text="诊断与关于" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid ColumnSpacing="16" Padding="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="诊断报告" FontSize="14" />
                            <TextBlock Text="仅保存在本机，可用于排查；不会自动上传。"
                                FontSize="12" TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button
                            x:Name="ExportDiagnosticsButton"
                            Grid.Column="1"
                            Content="导出诊断报告"
                            VerticalAlignment="Center"
                            Click="OnExportDiagnostics"
                            AutomationProperties.AutomationId="Ui4SettingsExportDiagnostics" />
                    </Grid>
                    <Grid ColumnSpacing="16" Padding="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="许可与第三方声明" FontSize="14" />
                            <TextBlock Text="查看随应用分发的许可与第三方组件信息。"
                                FontSize="12" TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                            <Button x:Name="LicenseButton" Content="许可" Click="OnLicense"
                                AutomationProperties.AutomationId="Ui4SettingsLicense" />
                            <Button x:Name="ThirdPartyButton" Content="第三方声明" Click="OnThirdParty"
                                AutomationProperties.AutomationId="Ui4SettingsThirdParty" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="16" Padding="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="关于" FontSize="14" />
                            <TextBlock Text="当前应用版本。"
                                FontSize="12" TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock
                            x:Name="VersionText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap"
                            AutomationProperties.AutomationId="Ui4SettingsVersion" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
