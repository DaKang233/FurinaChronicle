<UserControl
    x:Class="FurinaChronicle.Windows.Pages.ChroniclePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="Ui5ChroniclePage">
    <Grid Padding="24,16,24,16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="游戏历程" FontSize="28" FontWeight="SemiBold" />
            <TextBlock
                Text="按时间回顾抽卡、挑战与角色武器的重要节点。"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="6">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    x:Name="ArchivePicker"
                    Header="档案"
                    DisplayMemberPath="Label"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="档案"
                    AutomationProperties.AutomationId="Ui5ChronicleArchivePicker" />
                <ComboBox
                    x:Name="AccountPicker"
                    Grid.Column="1"
                    Header="账号范围"
                    DisplayMemberPath="Label"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="账号范围"
                    AutomationProperties.AutomationId="Ui5ChronicleAccountPicker" />
                <ComboBox
                    x:Name="TimelinePicker"
                    Grid.Column="2"
                    Header="时间线"
                    DisplayMemberPath="Label"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="时间线"
                    AutomationProperties.AutomationId="Ui5ChronicleTimelinePicker" />
                <ComboBox
                    x:Name="GranularityPicker"
                    Grid.Column="3"
                    Header="颗粒度"
                    DisplayMemberPath="Label"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="颗粒度"
                    AutomationProperties.AutomationId="Ui5ChronicleGranularityPicker" />
            </Grid>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    x:Name="TimeRangePicker"
                    Header="时间范围"
                    DisplayMemberPath="Label"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="时间范围"
                    AutomationProperties.AutomationId="Ui5ChronicleTimeRangePicker" />
                <ComboBox
                    x:Name="DomainPicker"
                    Grid.Column="1"
                    Header="领域"
                    DisplayMemberPath="Label"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="领域"
                    AutomationProperties.AutomationId="Ui5ChronicleDomainPicker" />
                <ComboBox
                    x:Name="RankPicker"
                    Grid.Column="2"
                    Header="星级"
                    DisplayMemberPath="Label"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="星级"
                    AutomationProperties.AutomationId="Ui5ChronicleRankPicker" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="20">
                <ToggleSwitch
                    x:Name="StateChangesSwitch"
                    Header="状态变化"
                    IsOn="False"
                    AutomationProperties.Name="显示状态变化"
                    AutomationProperties.AutomationId="Ui5ChronicleStateChanges" />
                <ToggleSwitch
                    x:Name="UndatedSwitch"
                    Header="未注明时间"
                    IsOn="True"
                    AutomationProperties.Name="显示未注明时间的条目"
                    AutomationProperties.AutomationId="Ui5ChronicleUndated" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="4">
            <StackPanel
                x:Name="StalePanel"
                Orientation="Horizontal"
                Spacing="10"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="StaleText"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    TextWrapping="Wrap"
                    AutomationProperties.AutomationId="Ui5ChronicleStale"
                    AutomationProperties.LiveSetting="Polite" />
                <Button
                    x:Name="StaleReloadButton"
                    Content="重新载入"
                    Click="OnReload"
                    AutomationProperties.Name="重新载入游戏历程"
                    AutomationProperties.AutomationId="Ui5ChronicleStaleReload" />
            </StackPanel>
            <TextBlock
                x:Name="EmptyText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed"
                AutomationProperties.AutomationId="Ui5ChronicleEmpty" />
        </StackPanel>

        <Grid Grid.Row="4" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="ReloadButton"
                Content="刷新"
                Click="OnReload"
                AutomationProperties.Name="刷新游戏历程"
                AutomationProperties.AutomationId="Ui5ChronicleReload" />
            <Button
                x:Name="LoadMoreButton"
                Grid.Column="1"
                Content="加载更多"
                Click="OnLoadMore"
                AutomationProperties.Name="加载更多历程"
                AutomationProperties.AutomationId="Ui5ChronicleLoadMore" />
            <ProgressRing
                x:Name="LoadingRing"
                Grid.Column="2"
                Width="20"
                Height="20"
                VerticalAlignment="Center"
                IsActive="False"
                Visibility="Collapsed"
                AutomationProperties.AutomationId="Ui5ChronicleLoading" />
            <TextBlock
                x:Name="PageText"
                Grid.Column="3"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                AutomationProperties.AutomationId="Ui5ChroniclePaging" />
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <ListView
                x:Name="EntryList"
                SelectionMode="Single"
                AutomationProperties.Name="游戏历程条目"
                AutomationProperties.AutomationId="Ui5ChronicleEntryList">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="8,6" Spacing="2">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Time.PrimaryText}" TextWrapping="Wrap" />
                            <TextBlock
                                Text="{Binding SummaryLine}"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Name="DetailTitleText"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap"
                    AutomationProperties.AutomationId="Ui5ChronicleDetailTitle" />
                <ScrollViewer Grid.Row="1">
                    <TextBlock
                        x:Name="DetailBodyText"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"
                        AutomationProperties.AutomationId="Ui5ChronicleDetail" />
                </ScrollViewer>
                <Expander
                    Grid.Row="2"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="Markdown 报告（只读）"
                    AutomationProperties.AutomationId="Ui5ChronicleReportExpander">
                    <Expander.Header>
                        <TextBlock Text="Markdown 报告（只读）" />
                    </Expander.Header>
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="GenerateReportButton"
                                Content="生成报告"
                                Click="OnGenerateReport"
                                AutomationProperties.Name="生成 Markdown 报告"
                                AutomationProperties.AutomationId="Ui5ChronicleGenerateReport" />
                            <Button
                                x:Name="CopyReportButton"
                                Content="复制报告"
                                Click="OnCopyReport"
                                AutomationProperties.Name="复制 Markdown 报告"
                                AutomationProperties.AutomationId="Ui5ChronicleCopyReport" />
                        </StackPanel>
                        <TextBox
                            x:Name="ReportBox"
                            Height="140"
                            AcceptsReturn="True"
                            IsReadOnly="True"
                            TextWrapping="Wrap"
                            AutomationProperties.Name="Markdown 报告内容"
                            AutomationProperties.AutomationId="Ui5ChronicleMarkdown" />
                    </StackPanel>
                </Expander>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
