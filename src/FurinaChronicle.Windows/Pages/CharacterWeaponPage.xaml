<UserControl
    x:Class="FurinaChronicle.Windows.Pages.CharacterWeaponPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="Ui5CharacterWeaponPage">
    <Grid Padding="24,16,24,16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock Text="角色与武器" FontSize="28" FontWeight="SemiBold" />
            <TextBlock
                Text="查看角色与武器的历史观察，默认显示最新一次。"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
            <Button
                x:Name="CollectButton"
                Content="采集最新记录"
                Click="OnCollect"
                AutomationProperties.Name="采集角色与武器最新记录"
                AutomationProperties.AutomationId="CharacterWeaponPageCollect" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="6">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    x:Name="ArchivePicker"
                    Header="档案"
                    DisplayMemberPath="Label"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="档案"
                    AutomationProperties.AutomationId="Ui5CharacterWeaponArchivePicker" />
                <ComboBox
                    x:Name="AccountPicker"
                    Grid.Column="1"
                    Header="账号"
                    DisplayMemberPath="Label"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="账号"
                    AutomationProperties.AutomationId="Ui5CharacterWeaponAccountPicker" />
                <ComboBox
                    x:Name="KindPicker"
                    Grid.Column="2"
                    Header="类别"
                    MinWidth="110"
                    AutomationProperties.Name="类别"
                    AutomationProperties.AutomationId="Ui5CharacterWeaponKindPicker" />
            </Grid>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="ReloadButton"
                    Content="刷新"
                    Click="OnReload"
                    AutomationProperties.Name="刷新角色与武器观察"
                    AutomationProperties.AutomationId="Ui5CharacterWeaponReload" />
                <Button
                    x:Name="PreviousButton"
                    Grid.Column="1"
                    Content="上一页"
                    Click="OnPrevious"
                    AutomationProperties.Name="上一页观察"
                    AutomationProperties.AutomationId="Ui5CharacterWeaponPrevious" />
                <Button
                    x:Name="NextButton"
                    Grid.Column="2"
                    Content="下一页"
                    Click="OnNext"
                    AutomationProperties.Name="下一页观察"
                    AutomationProperties.AutomationId="Ui5CharacterWeaponNext" />
                <ProgressRing
                    x:Name="LoadingRing"
                    Grid.Column="3"
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    IsActive="False"
                    Visibility="Collapsed"
                    AutomationProperties.AutomationId="Ui5CharacterWeaponLoading" />
                <TextBlock
                    x:Name="PageText"
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    AutomationProperties.AutomationId="Ui5CharacterWeaponPaging" />
            </Grid>
        </StackPanel>

        <TextBlock
            x:Name="EmptyText"
            Grid.Row="2"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed"
            AutomationProperties.AutomationId="Ui5CharacterWeaponEmpty" />

        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" MinWidth="145" />
                <ColumnDefinition Width="1.1*" MinWidth="140" />
                <ColumnDefinition Width="3.75*" />
            </Grid.ColumnDefinitions>
            <ListView
                x:Name="ObservationList"
                SelectionMode="Single"
                AutomationProperties.Name="角色与武器观察"
                AutomationProperties.AutomationId="Ui5CharacterWeaponObservationList">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="8,6" Spacing="2">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock
                                Text="{Binding ObservedText}"
                                FontSize="12"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ListView x:Name="CharacterList" Grid.Column="1" SelectionMode="Single"
                      SelectionChanged="OnCharacterChanged" DisplayMemberPath="Label"
                      AutomationProperties.Name="当前快照角色" />
            <Grid Grid.Column="2" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Name="DetailTitleText"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap"
                    AutomationProperties.AutomationId="Ui5CharacterWeaponDetailTitle" />
                <ScrollViewer x:Name="CharacterDetailScroll" Grid.Row="1">
                    <StackPanel x:Name="CharacterDetailStack" Spacing="12">
                    <TextBlock
                        x:Name="DetailBodyText"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"
                        AutomationProperties.AutomationId="Ui5CharacterWeaponDetail" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
