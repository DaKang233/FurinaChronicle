<UserControl x:Class="FurinaChronicle.Windows.Ui1GachaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FurinaChronicle.Windows">
    <UserControl.Resources>
        <local:GachaRarityBackgroundConverter x:Key="GachaRarityBackground" />
        <local:BooleanVisibilityConverter x:Key="BooleanVisibility" />
        <DataTemplate x:Key="GachaHistoryIcon">
            <StackPanel Width="74" Spacing="2">
                <Border Width="56" Height="56" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                    <Grid>
                        <Image Source="{Binding Rarity, Converter={StaticResource GachaRarityBackground}}" Stretch="UniformToFill" />
                        <Image Source="ms-appx:///Assets/ItemRarity/ui_imgsign_itemicon.png" Stretch="UniformToFill" />
                        <Image Loaded="OnArtworkLoaded" Unloaded="OnArtworkUnloaded"
                            DataContextChanged="OnArtworkContextChanged" Stretch="Uniform" />
                        <Border Background="#B3000000" CornerRadius="4" Padding="3,0"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Visibility="{Binding HasCount, Converter={StaticResource BooleanVisibility}}">
                            <TextBlock Text="{Binding CountText}" FontSize="11" Foreground="White" />
                        </Border>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                <TextBlock Text="{Binding Subtitle}" FontSize="11" TextAlignment="Center" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="GachaItemGroupHeader">
            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Margin="8,8,0,6" />
        </DataTemplate>
        <DataTemplate x:Key="GachaItemListEntry">
            <Grid ColumnSpacing="12" Margin="4,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <ContentControl Content="{Binding .}" ContentTemplate="{StaticResource GachaHistoryIcon}"
                    VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Rank}" />
                    <Button Content="{Binding Item.ToggleTimesText}" Click="OnToggleItemTimes"
                        Visibility="{Binding Item.CanExpandTimes, Converter={StaticResource BooleanVisibility}}" />
                    <TextBlock Text="{Binding Item.TimesText}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                        Visibility="{Binding Item.IsTimesVisible, Converter={StaticResource BooleanVisibility}}" />
                    <TextBlock Text="{Binding Item.TimeCountText}" FontSize="11"
                        Visibility="{Binding Item.IsTimesVisible, Converter={StaticResource BooleanVisibility}}" />
                    <Button Content="加载更多获取时间" Click="OnMoreItemTimes"
                        Visibility="{Binding Item.CanLoadMoreTimes, Converter={StaticResource BooleanVisibility}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="GachaHistoryLine">
            <Grid ColumnSpacing="8" Margin="2,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Subtitle}" FontWeight="SemiBold" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="OverviewCardTemplate">
            <Border Width="370" Padding="12" Margin="0,0,12,0" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                Loaded="OnOverviewCardLoaded" Unloaded="OnOverviewCardUnloaded">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
                    <Expander Grid.Row="1" Header="统计信息" IsExpanded="True"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <TextBlock Text="{Binding Statistics}" FontSize="12" LineHeight="18" TextWrapping="Wrap" />
                    </Expander>
                    <StackPanel Grid.Row="2" Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Button Content="{Binding TruePullsToggleText}" Click="OnOverviewTruePulls"
                                Visibility="{Binding CanShowTruePulls, Converter={StaticResource BooleanVisibility}}"
                                AutomationProperties.Name="切换角色活动祈愿真实抽数" />
                            <Button Content="{Binding LayoutToggleText}" Click="OnOverviewLayout"
                                Visibility="{Binding CanChangeLayout, Converter={StaticResource BooleanVisibility}}"
                                AutomationProperties.Name="切换五星图标与列表" />
                        </StackPanel>
                        <TextBlock Text="{Binding HistoryLabel}" FontWeight="SemiBold" />
                    </StackPanel>
                    <Grid Grid.Row="3">
                        <GridView ItemsSource="{Binding VisibleItems}" ItemTemplate="{StaticResource GachaHistoryIcon}"
                            Visibility="{Binding IsGridMode, Converter={StaticResource BooleanVisibility}}"
                            SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnOpenDetail"
                            HorizontalContentAlignment="Stretch">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="82" ItemHeight="102" /></ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.Footer>
                                <Button Content="{Binding LoadMoreText}" Click="OnOverviewMore"
                                    Visibility="{Binding CanLoadMore, Converter={StaticResource BooleanVisibility}}" />
                            </GridView.Footer>
                        </GridView>
                        <ListView ItemsSource="{Binding VisibleItems}" ItemTemplate="{StaticResource GachaHistoryLine}"
                            Visibility="{Binding IsListMode, Converter={StaticResource BooleanVisibility}}"
                            SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnOpenDetail">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                            </ListView.ItemContainerStyle>
                            <ListView.Footer>
                                <Button Content="{Binding LoadMoreText}" Click="OnOverviewMore"
                                    Visibility="{Binding CanLoadMore, Converter={StaticResource BooleanVisibility}}" />
                            </ListView.Footer>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="HistorySelectorTemplate">
            <StackPanel Spacing="4" Padding="2,6">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding History.Version}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding History.Total}" FontWeight="SemiBold" />
                </Grid>
                <ItemsControl ItemsSource="{Binding History.FeaturedItems}" ItemTemplate="{StaticResource GachaHistoryIcon}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapGrid Orientation="Horizontal" ItemWidth="76" ItemHeight="95" MaximumRowsOrColumns="4" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Text="{Binding History.Period}" FontSize="10" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="GachaPeriodHeader">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Period}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Total}" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding Banners}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Image Height="180" HorizontalAlignment="Left" Stretch="Uniform"
                                AutomationProperties.Name="{Binding Name}"
                                Loaded="OnArtworkLoaded" Unloaded="OnArtworkUnloaded"
                                DataContextChanged="OnArtworkContextChanged" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="SelectedHistoryTextTemplate">
            <StackPanel Spacing="10" Padding="8,0">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GachaPeriodHeader}"
                    HorizontalContentAlignment="Stretch" />
                <TextBlock Text="{Binding ItemsText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <TextBlock Text="{Binding Metadata}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="SelectedHistoryTemplate">
            <StackPanel Spacing="10" Padding="8,0">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GachaPeriodHeader}"
                    HorizontalContentAlignment="Stretch" />
                <ItemsControl ItemsSource="{Binding VisibleItems}" ItemTemplate="{StaticResource GachaHistoryIcon}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapGrid Orientation="Horizontal" ItemWidth="82" ItemHeight="102" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Button Content="{Binding LoadMoreText}" Click="OnHistoryMore"
                    Visibility="{Binding CanLoadMore, Converter={StaticResource BooleanVisibility}}" />
                <TextBlock Text="{Binding Metadata}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="RecordTableTemplate">
            <Grid ColumnSpacing="10" Padding="4,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="58" /><ColumnDefinition Width="64" /><ColumnDefinition Width="116" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Time}" TextWrapping="Wrap" />
                <Grid Grid.Column="1" ColumnSpacing="7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid Width="30" Height="30" VerticalAlignment="Top">
                        <Image Source="{Binding Rarity, Converter={StaticResource GachaRarityBackground}}" Stretch="UniformToFill" />
                        <Image Stretch="Uniform" Loaded="OnArtworkLoaded"
                            Unloaded="OnArtworkUnloaded" DataContextChanged="OnArtworkContextChanged" />
                    </Grid>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding AccountLabel}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Column="2" Text="{Binding Rank}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="3" Text="{Binding ItemType}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="4" Text="{Binding Pool}" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="RecordListTemplate">
            <Grid Padding="4,10" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="6" VerticalAlignment="Top"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid>
                        <Image Source="{Binding Rarity, Converter={StaticResource GachaRarityBackground}}" Stretch="UniformToFill" />
                        <TextBlock Text="{Binding Rank}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Stretch="Uniform" Loaded="OnArtworkLoaded" Unloaded="OnArtworkUnloaded"
                            DataContextChanged="OnArtworkContextChanged" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="13" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
    <ContentControl x:Name="GachaWorkspace" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <Grid Padding="16,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="抽卡分析" FontSize="26" FontWeight="SemiBold" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ArchivePicker" IsEnabled="False" Header="档案" DisplayMemberPath="Label"
                HorizontalAlignment="Stretch" AutomationProperties.AutomationId="Ui1Archive"
                SelectionChanged="OnArchiveChanged" />
            <ComboBox x:Name="AccountPicker" IsEnabled="False" Grid.Column="1" Header="账号" DisplayMemberPath="Label"
                HorizontalAlignment="Stretch" AutomationProperties.AutomationId="Ui1Account"
                SelectionChanged="OnAccountChanged" />
            <Button x:Name="RangeButton" IsEnabled="False" Grid.Column="2" Content="档案多选" VerticalAlignment="Bottom" Click="OnRange"
                AutomationProperties.AutomationId="GachaRange" />
        </Grid>
        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ViewPicker" IsEnabled="False" DisplayMemberPath="Label" SelectionChanged="OnViewChanged" AutomationProperties.Name="分析视图"
                AutomationProperties.AutomationId="GachaView" />
            <Button x:Name="FilterButton" IsEnabled="False" Grid.Column="1" Content="筛选" Click="OnFilter"
                AutomationProperties.AutomationId="GachaFilter" />
            <TextBlock x:Name="SummaryText" Grid.Column="2" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.AutomationId="Ui1Summary" />
            <Button x:Name="ReloadButton" IsEnabled="False" Grid.Column="3" Content="重新载入" Click="OnReload"
                AutomationProperties.AutomationId="GachaReload">
                <Button.KeyboardAccelerators><KeyboardAccelerator Key="F5" /></Button.KeyboardAccelerators>
            </Button>
            <Button x:Name="CancelButton" Grid.Column="4" Content="取消" Click="OnCancel"
                AutomationProperties.AutomationId="GachaCancel" />
            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8">
                <Button x:Name="ImportButton" Content="导入" IsEnabled="False" Click="OnImport"
                    AutomationProperties.AutomationId="GachaImport"
                    AutomationProperties.Name="导入抽卡文件">
                    <Button.KeyboardAccelerators><KeyboardAccelerator Key="I" Modifiers="Control" /></Button.KeyboardAccelerators>
                </Button>
                <Button x:Name="ImportModeButton" Content="仅补充" Click="OnToggleImportMode"
                    AutomationProperties.AutomationId="GachaImportMode" />
                <Button x:Name="DataCommandsButton" Content="数据操作"
                    AutomationProperties.AutomationId="GachaDataCommands"
                    AutomationProperties.Name="数据操作（Portable、手动链接、图标缓存）">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="导入 Furina 抽卡数据集…" Tag="portable-import"
                                Click="OnDataMenuCommand"
                                AutomationProperties.AutomationId="GachaPortableImport" />
                            <MenuFlyoutItem Text="从提瓦特小助手导入…" Tag="teyvat-import"
                                Click="OnDataMenuCommand"
                                AutomationProperties.AutomationId="GachaTeyvatHelperImport" />
                            <MenuFlyoutItem Text="导出 Furina 抽卡数据集…" Tag="portable-export"
                                Click="OnDataMenuCommand"
                                AutomationProperties.AutomationId="GachaPortableExport" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="手动链接刷新…" Tag="manual-refresh"
                                Click="OnDataMenuCommand"
                                AutomationProperties.AutomationId="GachaManualRefresh" />
                            <MenuFlyoutItem Text="通过登录账号刷新…" Tag="stoken-refresh"
                                Click="OnDataMenuCommand"
                                AutomationProperties.AutomationId="GachaSTokenRefresh" />
                            <MenuFlyoutItem Text="通过网页缓存刷新…" Tag="windows-cache-refresh"
                                Click="OnDataMenuCommand"
                                AutomationProperties.AutomationId="GachaWindowsCacheRefresh" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="撤销最近一次抽卡变更…" Tag="undo-record"
                                Click="OnDataMenuCommand"
                                AutomationProperties.AutomationId="GachaRecordUndo" />
                            <MenuFlyoutItem Text="清除图标缓存…" Tag="clear-icon-cache"
                                Click="OnDataMenuCommand"
                                AutomationProperties.AutomationId="GachaClearIconCache" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="ExportButton" Content="导出" IsEnabled="False" Click="OnExport"
                    AutomationProperties.AutomationId="GachaExport">
                    <Button.KeyboardAccelerators><KeyboardAccelerator Key="E" Modifiers="Control" /></Button.KeyboardAccelerators>
                </Button>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="3" Spacing="3">
            <TextBlock x:Name="ImportModeDescription" FontSize="12" TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                AutomationProperties.AutomationId="GachaImportModeDescription" />
            <TextBlock x:Name="InlineValidation" TextWrapping="Wrap" Visibility="Collapsed"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                AutomationProperties.AutomationId="GachaInlineValidation"
                AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <Grid x:Name="ViewBody" Grid.Row="4" ColumnSpacing="12" SizeChanged="OnBodySizeChanged">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="DetailColumn" Width="0" /></Grid.ColumnDefinitions>
            <Grid RowSpacing="4">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid x:Name="TableHeader" Padding="16,4" ColumnSpacing="10" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="58" /><ColumnDefinition Width="64" /><ColumnDefinition Width="116" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="时间" /><TextBlock Grid.Column="1" Text="物品 / 账号" />
                    <TextBlock Grid.Column="2" Text="星级" /><TextBlock Grid.Column="3" Text="类型" />
                    <TextBlock Grid.Column="4" Text="卡池" />
                </Grid>
                <Grid x:Name="HistoryPanel" Grid.Row="1" Visibility="Collapsed" RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CacheBannersButton" Content="缓存全部横幅" Click="OnCacheBanners"
                            AutomationProperties.AutomationId="GachaHistoryCacheBanners" />
                        <Button x:Name="ClearBannersButton" Content="清除横幅缓存" Click="OnClearBanners"
                            AutomationProperties.AutomationId="GachaHistoryClearBanners" />
                        <ComboBox x:Name="HistoryVersionPicker" MinWidth="100"
                            SelectionChanged="OnHistoryVersionChanged"
                            AutomationProperties.Name="历史版本" AutomationProperties.AutomationId="GachaHistoryVersion" />
                        <ToggleSwitch x:Name="HistoryIconToggle" Header="物品图标" IsOn="True" Toggled="OnHistoryDisplayChanged"
                            AutomationProperties.AutomationId="GachaHistoryIconMode" />
                    </StackPanel>
                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="330" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ListView x:Name="HistoryList" ItemTemplate="{StaticResource HistorySelectorTemplate}"
                            SelectionChanged="OnHistorySelectionChanged"
                            AutomationProperties.Name="独立卡池历史" AutomationProperties.AutomationId="GachaHistoryList">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="10">
                                <ContentControl x:Name="HistoryContent" ContentTemplate="{StaticResource SelectedHistoryTemplate}"
                                    HorizontalContentAlignment="Stretch" AutomationProperties.Name="所选卡池详情"
                                    AutomationProperties.AutomationId="GachaHistoryDetail" />
                                <TextBlock x:Name="HistoryText" Visibility="Collapsed" TextWrapping="Wrap"
                                    IsTextSelectionEnabled="True" AutomationProperties.AutomationId="GachaHistoryText" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
                <ScrollViewer x:Name="OverviewScroll" Grid.Row="1" Visibility="Collapsed"
                    HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled"
                    SizeChanged="OnOverviewViewportSizeChanged">
                    <ItemsControl x:Name="OverviewCards" ItemTemplate="{StaticResource OverviewCardTemplate}"
                        AutomationProperties.Name="按卡池分组的抽卡总览">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                <ListView x:Name="RecordsList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True"
                    ItemClick="OnOpenDetail" ItemTemplate="{StaticResource RecordListTemplate}" AutomationProperties.AutomationId="Ui1Records">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                    </ListView.ItemContainerStyle>
                </ListView>
                <Grid x:Name="ItemPanel" Grid.Row="1" Visibility="Collapsed" RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="ItemScopeText" VerticalAlignment="Center" />
                        <Button x:Name="ItemLayoutButton" Content="列表与时间" Click="OnItemLayoutChanged"
                            AutomationProperties.AutomationId="GachaItemLayout" />
                    </StackPanel>
                    <GridView x:Name="ItemGrid" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True"
                        ItemClick="OnOpenDetail" AutomationProperties.Name="物品网格"
                        AutomationProperties.AutomationId="GachaItemGrid"
                        ItemTemplate="{StaticResource GachaHistoryIcon}">
                        <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="86" ItemHeight="102" /></ItemsPanelTemplate></GridView.ItemsPanel>
                        <GridView.GroupStyle>
                            <GroupStyle HeaderTemplate="{StaticResource GachaItemGroupHeader}" HidesIfEmpty="True" />
                        </GridView.GroupStyle>
                    </GridView>
                    <ListView x:Name="ItemList" Grid.Row="1" SelectionMode="None" Visibility="Collapsed"
                        ItemTemplate="{StaticResource GachaItemListEntry}"
                        AutomationProperties.Name="物品与获取时间" AutomationProperties.AutomationId="GachaItemList">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                        </ListView.ItemContainerStyle>
                        <ListView.GroupStyle>
                            <GroupStyle HeaderTemplate="{StaticResource GachaItemGroupHeader}" HidesIfEmpty="True" />
                        </ListView.GroupStyle>
                    </ListView>
                </Grid>
                <ScrollViewer x:Name="CalendarScroll" Grid.Row="1" Visibility="Collapsed"
                    HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" AutomationProperties.Name="年度抽卡热力图">
                    <StackPanel Spacing="12" Padding="6,10">
                        <TextBlock x:Name="CalendarMonthText" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="CalendarSummaryText" TextWrapping="Wrap" />
                        <Grid x:Name="CalendarGrid" ColumnSpacing="3" RowSpacing="3" HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="GachaCalendarHeatmap" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="少" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <Border x:Name="CalendarLegend0" Width="12" Height="12" CornerRadius="3" />
                            <Border x:Name="CalendarLegend1" Width="12" Height="12" CornerRadius="3" />
                            <Border x:Name="CalendarLegend2" Width="12" Height="12" CornerRadius="3" />
                            <Border x:Name="CalendarLegend3" Width="12" Height="12" CornerRadius="3" />
                            <Border x:Name="CalendarLegend4" Width="12" Height="12" CornerRadius="3" />
                            <Border x:Name="CalendarLegend5" Width="12" Height="12" CornerRadius="3" />
                            <TextBlock Text="多" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="每列为一周，每行为星期一至星期日。悬停查看当天统计，点击查看明细。"
                            FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <ScrollViewer x:Name="DetailPane" Grid.Column="1" Visibility="Collapsed" Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" AutomationProperties.Name="并排详情">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="DetailTitle" Text="请选择条目" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailBody" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite" />
                    <StackPanel x:Name="RecordOperationPanel" Orientation="Horizontal" Spacing="8"
                        Visibility="Collapsed">
                        <Button x:Name="CorrectRecordButton" Content="纠正" Click="OnCorrectRecordCommand"
                            IsEnabled="False" AutomationProperties.AutomationId="GachaRecordCorrect"
                            AutomationProperties.Name="纠正所选记录" />
                        <Button x:Name="DeleteRecordButton" Content="删除" Click="OnDeleteRecordCommand"
                            IsEnabled="False" AutomationProperties.AutomationId="GachaRecordDelete"
                            AutomationProperties.Name="删除所选记录（可撤销）" />
                        <Button x:Name="IrreversibleDeleteButton" Content="永久删除"
                            Click="OnIrreversibleDeleteCommand" IsEnabled="False"
                            AutomationProperties.AutomationId="GachaRecordIrreversibleDelete"
                            AutomationProperties.Name="永久删除所选记录（不可撤销）" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid Grid.Row="5" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button x:Name="PreviousButton" Content="上一页" Click="OnPrevious" />
            <Button x:Name="NextButton" Grid.Column="1" Content="下一页" Click="OnNext" />
            <ComboBox x:Name="PageSizePicker" Grid.Column="2" HorizontalAlignment="Right"
                SelectionChanged="OnPageSizeChanged" AutomationProperties.Name="每页记录数"
                AutomationProperties.AutomationId="GachaPageSize" Visibility="Collapsed" />
        </Grid>
    </Grid>
    </ContentControl>
        <Grid x:Name="RefreshOverlay" Visibility="Collapsed" Background="#C5000000"
            AutomationProperties.Name="抽卡刷新进度" AutomationProperties.AutomationId="GachaRefreshProgress">
            <Border MaxWidth="740" Margin="16" Padding="20" CornerRadius="10" BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="RefreshTitle" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ProgressRing x:Name="RefreshRing" Width="24" Height="24" IsActive="True" />
                            <TextBlock x:Name="RefreshPool" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                AutomationProperties.AutomationId="GachaRefreshPool" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <TextBlock x:Name="RefreshDetail" TextWrapping="Wrap"
                            AutomationProperties.AutomationId="GachaRefreshDetail" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="刷新过程中无法切换页面或执行其他数据操作。这里展示本次获取的物品，实际保存数量以完成统计为准。"
                        FontSize="12" TextWrapping="Wrap" />
                    <TextBlock x:Name="RefreshTotals" Grid.Row="2" FontWeight="SemiBold"
                        AutomationProperties.AutomationId="GachaRefreshTotals" />
                    <GridView x:Name="RefreshItems" Grid.Row="3" SelectionMode="None"
                        ItemTemplate="{StaticResource GachaHistoryIcon}"
                        AutomationProperties.Name="本次刷新获取到的物品" AutomationProperties.AutomationId="GachaRefreshItems">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="86" ItemHeight="102" /></ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                    </GridView>
                    <Button x:Name="RefreshClose" Grid.Row="4" Content="关闭" IsEnabled="False" HorizontalAlignment="Right"
                        Click="OnCloseRefresh" AutomationProperties.Name="关闭抽卡刷新结果"
                        AutomationProperties.AutomationId="GachaRefreshClose" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
