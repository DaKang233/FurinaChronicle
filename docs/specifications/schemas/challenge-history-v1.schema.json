{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.dakang233.com/schemas/furina-challenge-history/1/dataset.schema.json",
  "title": "Furina challenge history Portable v1",
  "type": "object",
  "required": ["format", "package"],
  "properties": {
    "format": { "const": "furina-domain-history" },
    "package": {
      "type": "object",
      "required": ["dataset_kind", "format_major", "format_minor", "package_fingerprint", "source_archive_id", "source_archive_name", "exported_at", "accounts"],
      "properties": {
        "dataset_kind": { "const": 2 },
        "format_major": { "const": 1 },
        "format_minor": { "type": "integer", "minimum": 0 },
        "package_fingerprint": { "$ref": "#/$defs/sha256" },
        "source_archive_id": { "$ref": "#/$defs/guid" },
        "source_archive_name": { "type": "string", "minLength": 1 },
        "exported_at": { "type": "string", "format": "date-time" },
        "accounts": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/account" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "guid": { "type": "string", "format": "uuid" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identity": {
      "type": "object",
      "required": ["id", "natural_identity"],
      "properties": {
        "id": { "$ref": "#/$defs/guid" },
        "natural_identity": {
          "type": "object",
          "required": ["game_biz", "server", "uid"],
          "properties": {
            "game_biz": { "enum": ["hk4e_cn", "hk4e_global"] },
            "server": { "enum": ["cn_gf01", "cn_qd01", "os_usa", "os_euro", "os_asia", "os_cht"] },
            "uid": { "type": "string", "pattern": "^[0-9]+$" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "occurrence": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": [0, 1, 2, 3] },
        "start": { "type": ["string", "null"], "format": "date-time" },
        "end": { "type": ["string", "null"], "format": "date-time" },
        "precision": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": ["origin", "timestamps"],
      "properties": {
        "origin": { "enum": [0, 1, 2, 3, 4, 5, 6, 7] },
        "timestamps": { "type": "object" },
        "source": { "type": ["object", "null"] },
        "acquisition_batch_id": { "oneOf": [{ "$ref": "#/$defs/guid" }, { "type": "null" }] }
      },
      "additionalProperties": true
    },
    "chamber": {
      "type": "object",
      "required": ["chamber", "stars", "completed_at"],
      "properties": {
        "chamber": { "type": "integer", "minimum": 1 },
        "stars": { "type": "integer", "minimum": 0, "maximum": 3 },
        "completed_at": { "$ref": "#/$defs/occurrence" }
      },
      "additionalProperties": true
    },
    "floor": {
      "type": "object",
      "required": ["floor", "completeness", "chambers"],
      "properties": {
        "floor": { "type": "integer", "minimum": 1 },
        "completeness": { "enum": [0, 1, 2] },
        "chambers": { "type": "array", "items": { "$ref": "#/$defs/chamber" } }
      },
      "additionalProperties": true
    },
    "observation": {
      "type": "object",
      "required": ["observation_id", "game_account_id", "mode", "season_id", "completeness", "spiral_abyss_floors", "provenance"],
      "properties": {
        "observation_id": { "$ref": "#/$defs/guid" },
        "game_account_id": { "$ref": "#/$defs/guid" },
        "mode": { "const": 1 },
        "season_id": { "type": "string", "minLength": 1 },
        "period_start": { "type": ["string", "null"], "format": "date-time" },
        "period_end": { "type": ["string", "null"], "format": "date-time" },
        "completeness": { "enum": [0, 1, 2] },
        "spiral_abyss_floors": { "type": "array", "items": { "$ref": "#/$defs/floor" } },
        "provenance": { "$ref": "#/$defs/source" }
      },
      "additionalProperties": true
    },
    "account": {
      "type": "object",
      "required": ["source_account_id", "role_identity", "item_observations", "manual_acquisitions", "manual_revisions", "challenge_observations"],
      "properties": {
        "source_account_id": { "$ref": "#/$defs/guid" },
        "role_identity": { "$ref": "#/$defs/identity" },
        "item_observations": { "type": "array", "maxItems": 0 },
        "manual_acquisitions": { "type": "array", "maxItems": 0 },
        "manual_revisions": { "type": "array", "maxItems": 0 },
        "challenge_observations": { "type": "array", "items": { "$ref": "#/$defs/observation" } }
      },
      "additionalProperties": true
    }
  }
}
