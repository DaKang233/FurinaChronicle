{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.dakang233.com/schemas/furina-character-weapon-history/1/dataset.schema.json",
  "title": "Furina character and weapon history Portable v1 and v2",
  "type": "object",
  "required": ["format", "package"],
  "properties": {
    "format": { "const": "furina-domain-history" },
    "package": {
      "type": "object",
      "required": ["dataset_kind", "format_major", "format_minor", "package_fingerprint", "source_archive_id", "source_archive_name", "exported_at", "accounts"],
      "properties": {
        "dataset_kind": { "const": 1 },
        "format_major": { "enum": [1, 2] },
        "format_minor": { "type": "integer", "minimum": 0 },
        "package_fingerprint": { "$ref": "#/$defs/sha256" },
        "source_archive_id": { "$ref": "#/$defs/guid" },
        "source_archive_name": { "type": "string", "minLength": 1 },
        "exported_at": { "type": "string", "format": "date-time" },
        "accounts": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/account" }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "character_ascension_evidence": {"type": "object", "properties": {"name": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "icon": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "weapon_type": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "rarity": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "element_id": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "maximum_level": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "current_level": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "target_level": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "stage": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "constellation_count": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "friendship": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "wiki_url": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "recommended_weapon_wiki_url": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "skills": {"anyOf": [{"type": "array", "items": {"$ref": "#/$defs/character_calculator_skill"}}, {"type": "null"}]}, "weapon": {"anyOf": [{"$ref": "#/$defs/character_calculator_weapon"}, {"type": "null"}]}, "artifacts": {"anyOf": [{"type": "array", "items": {"$ref": "#/$defs/character_calculator_artifact"}}, {"type": "null"}]}}, "additionalProperties": false},
    "character_calculator_skill": {"type": "object", "properties": {"id": {"type": "integer"}, "group_id": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "name": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "icon": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "current_level": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "target_level": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "maximum_level": {"anyOf": [{"type": "integer"}, {"type": "null"}]}}, "additionalProperties": false, "required": ["id"]},
    "character_calculator_weapon": {"type": "object", "properties": {"id": {"type": "integer"}, "name": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "icon": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "type": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "rarity": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "current_level": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "target_level": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "maximum_level": {"anyOf": [{"type": "integer"}, {"type": "null"}]}}, "additionalProperties": false, "required": ["id"]},
    "character_calculator_artifact": {"type": "object", "properties": {"id": {"type": "integer"}, "name": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "icon": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "slot": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "rarity": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "current_level": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "target_level": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "maximum_level": {"anyOf": [{"type": "integer"}, {"type": "null"}]}}, "additionalProperties": false, "required": ["id"]},
    "character_detail": {"type": "object", "properties": {"name": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "element": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "rarity": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "friendship": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "ascension": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "icon": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "side_icon": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "portrait": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "card_image": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "is_featured": {"anyOf": [{"type": "boolean"}, {"type": "null"}]}, "weapon_type": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "weapon": {"anyOf": [{"$ref": "#/$defs/character_weapon_detail"}, {"type": "null"}]}, "constellations": {"anyOf": [{"type": "array", "items": {"$ref": "#/$defs/character_constellation"}}, {"type": "null"}]}, "talents": {"anyOf": [{"type": "array", "items": {"$ref": "#/$defs/character_talent"}}, {"type": "null"}]}, "selected_stats": {"anyOf": [{"type": "array", "items": {"$ref": "#/$defs/character_stat"}}, {"type": "null"}]}, "base_stats": {"anyOf": [{"type": "array", "items": {"$ref": "#/$defs/character_stat"}}, {"type": "null"}]}, "advanced_stats": {"anyOf": [{"type": "array", "items": {"$ref": "#/$defs/character_stat"}}, {"type": "null"}]}, "elemental_stats": {"anyOf": [{"type": "array", "items": {"$ref": "#/$defs/character_stat"}}, {"type": "null"}]}, "artifacts": {"anyOf": [{"type": "array", "items": {"$ref": "#/$defs/character_artifact"}}, {"type": "null"}]}, "costumes": {"anyOf": [{"type": "array", "items": {"$ref": "#/$defs/character_costume"}}, {"type": "null"}]}, "artifact_recommendation": {"anyOf": [{"$ref": "#/$defs/character_artifact_recommendation"}, {"type": "null"}]}, "is_tps_unlocked": {"anyOf": [{"type": "boolean"}, {"type": "null"}]}, "weapon_skin": {"anyOf": [{"$ref": "#/$defs/character_weapon_skin"}, {"type": "null"}]}, "base_weapon": {"anyOf": [{"$ref": "#/$defs/character_weapon_detail"}, {"type": "null"}]}, "roster": {"anyOf": [{"$ref": "#/$defs/character_roster_entry"}, {"type": "null"}]}, "ascension_evidence": {"$ref": "#/$defs/character_ascension_evidence"}}, "additionalProperties": false},
    "character_roster_entry": {"type": "object", "properties": {"level": {"type": "integer"}, "constellation_count": {"type": "integer"}, "name": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "element": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "rarity": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "friendship": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "ascension": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "weapon_type": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "icon": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "side_icon": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "portrait": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "card_image": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "is_featured": {"anyOf": [{"type": "boolean"}, {"type": "null"}]}, "weapon": {"anyOf": [{"$ref": "#/$defs/character_weapon_detail"}, {"type": "null"}]}}, "additionalProperties": false, "required": ["level", "constellation_count"]},
    "character_stat": {"type": "object", "properties": {"property_id": {"type": "integer"}, "base": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "bonus": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "total": {"anyOf": [{"type": "string"}, {"type": "null"}]}}, "additionalProperties": false, "required": ["property_id"]},
    "character_property_metadata": {"type": "object", "properties": {"property_id": {"type": "integer"}, "name": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "icon": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "filter_name": {"anyOf": [{"type": "string"}, {"type": "null"}]}}, "additionalProperties": false, "required": ["property_id"]},
    "character_weapon_detail": {"type": "object", "properties": {"id": {"type": "integer"}, "name": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "icon": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "type": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "type_name": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "rarity": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "level": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "refinement": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "ascension": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "description": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "main_stat": {"anyOf": [{"$ref": "#/$defs/character_stat"}, {"type": "null"}]}, "secondary_stat": {"anyOf": [{"$ref": "#/$defs/character_stat"}, {"type": "null"}]}}, "additionalProperties": false, "required": ["id"]},
    "character_weapon_skin": {"type": "object", "properties": {"name": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "icon": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "rarity": {"anyOf": [{"type": "integer"}, {"type": "null"}]}}, "additionalProperties": false},
    "character_costume": {"type": "object", "properties": {"id": {"type": "integer"}, "name": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "icon": {"anyOf": [{"type": "string"}, {"type": "null"}]}}, "additionalProperties": false, "required": ["id"]},
    "character_constellation": {"type": "object", "properties": {"id": {"type": "integer"}, "position": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "name": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "icon": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "unlocked": {"anyOf": [{"type": "boolean"}, {"type": "null"}]}, "description": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "enhancement": {"$ref": "#/$defs/character_enhancement"}}, "additionalProperties": false, "required": ["id"]},
    "character_talent": {"type": "object", "properties": {"id": {"type": "integer"}, "type": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "level": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "name": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "icon": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "unlocked": {"anyOf": [{"type": "boolean"}, {"type": "null"}]}, "description": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "attributes": {"anyOf": [{"type": "array", "items": {"$ref": "#/$defs/character_talent_value"}}, {"type": "null"}]}, "enhancement": {"$ref": "#/$defs/character_enhancement"}, "before_enhancement_indexes": {"type": "array", "items": {"type": "integer"}}, "after_enhancement_indexes": {"type": "array", "items": {"type": "integer"}}}, "additionalProperties": false, "required": ["id"]},
    "character_enhancement": {"type": "object", "properties": {"can_enhance": {"type": ["boolean", "null"]}, "is_enhanced": {"type": ["boolean", "null"]}, "description": {"type": ["string", "null"]}}, "additionalProperties": false},
    "character_talent_value": {"type": "object", "properties": {"name": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "value": {"anyOf": [{"type": "string"}, {"type": "null"}]}}, "additionalProperties": false},
    "character_artifact": {"type": "object", "properties": {"id": {"type": "integer"}, "slot": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "slot_name": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "name": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "icon": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "rarity": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "level": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "set": {"anyOf": [{"$ref": "#/$defs/character_artifact_set"}, {"type": "null"}]}, "main_stat": {"anyOf": [{"$ref": "#/$defs/character_artifact_stat"}, {"type": "null"}]}, "sub_stats": {"anyOf": [{"type": "array", "items": {"$ref": "#/$defs/character_artifact_stat"}}, {"type": "null"}]}}, "additionalProperties": false, "required": ["id"]},
    "character_artifact_stat": {"type": "object", "properties": {"property_id": {"type": "integer"}, "value": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "hits": {"anyOf": [{"type": "integer"}, {"type": "null"}]}}, "additionalProperties": false, "required": ["property_id"]},
    "character_artifact_set": {"type": "object", "properties": {"id": {"type": "integer"}, "name": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "bonuses": {"anyOf": [{"type": "array", "items": {"$ref": "#/$defs/character_set_bonus"}}, {"type": "null"}]}}, "additionalProperties": false, "required": ["id"]},
    "character_set_bonus": {"type": "object", "properties": {"pieces": {"anyOf": [{"type": "integer"}, {"type": "null"}]}, "description": {"anyOf": [{"type": "string"}, {"type": "null"}]}}, "additionalProperties": false},
    "character_artifact_recommendation": {"type": "object", "properties": {"recommended": {"anyOf": [{"$ref": "#/$defs/character_recommended_stats"}, {"type": "null"}]}, "custom": {"anyOf": [{"$ref": "#/$defs/character_recommended_stats"}, {"type": "null"}]}, "has_set_recommendation": {"anyOf": [{"type": "boolean"}, {"type": "null"}]}}, "additionalProperties": false},
    "character_recommended_stats": {"type": "object", "properties": {"sands": {"anyOf": [{"type": "array", "items": {"type": "integer"}}, {"type": "null"}]}, "goblet": {"anyOf": [{"type": "array", "items": {"type": "integer"}}, {"type": "null"}]}, "circlet": {"anyOf": [{"type": "array", "items": {"type": "integer"}}, {"type": "null"}]}, "sub_stats": {"anyOf": [{"type": "array", "items": {"type": "integer"}}, {"type": "null"}]}}, "additionalProperties": false},
    "character_response_metadata": {"type": "object", "properties": {"properties": {"anyOf": [{"type": "object", "additionalProperties": {"$ref": "#/$defs/character_property_metadata"}}, {"type": "null"}]}, "artifact_property_options": {"anyOf": [{"$ref": "#/$defs/character_recommended_stats"}, {"type": "null"}]}, "artifact_wiki": {"anyOf": [{"type": "object", "additionalProperties": {"type": "string"}}, {"type": "null"}]}, "weapon_wiki": {"anyOf": [{"type": "object", "additionalProperties": {"type": "string"}}, {"type": "null"}]}, "avatar_wiki": {"anyOf": [{"type": "object", "additionalProperties": {"type": "string"}}, {"type": "null"}]}}, "additionalProperties": false},
    "guid": { "type": "string", "format": "uuid" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identity": {
      "type": "object",
      "required": ["id", "natural_identity"],
      "properties": {
        "id": { "$ref": "#/$defs/guid" },
        "natural_identity": {
          "type": "object",
          "required": ["game_biz", "server", "uid"],
          "properties": {
            "game_biz": { "enum": ["hk4e_cn", "hk4e_global"] },
            "server": { "enum": ["cn_gf01", "cn_qd01", "os_usa", "os_euro", "os_asia", "os_cht"] },
            "uid": { "type": "string", "pattern": "^[0-9]+$" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "timestamps": {
      "type": "object",
      "properties": {
        "observed_at": { "type": ["string", "null"], "format": "date-time" },
        "fetched_at": { "type": ["string", "null"], "format": "date-time" },
        "imported_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": ["origin", "timestamps"],
      "properties": {
        "origin": { "enum": [0, 1, 2, 3, 4, 5, 6, 7] },
        "timestamps": { "$ref": "#/$defs/timestamps" },
        "source": { "type": ["object", "null"] },
        "acquisition_batch_id": { "oneOf": [{ "$ref": "#/$defs/guid" }, { "type": "null" }] }
      },
      "additionalProperties": true
    },
    "entry": {
      "type": "object",
      "required": ["kind", "type_id", "field_coverage", "field_completeness"],
      "properties": {
        "kind": { "enum": [1, 2] },
        "type_id": { "type": "string", "minLength": 1 },
        "instance_id": { "type": ["string", "null"] },
        "quantity": { "type": ["integer", "null"], "minimum": 0 },
        "level": { "type": ["integer", "null"], "minimum": 0 },
        "progression": { "type": ["integer", "null"], "minimum": 0 },
        "field_coverage": { "type": "integer", "minimum": 0, "maximum": 7 },
        "field_completeness": { "enum": [0, 1, 2] },
        "character_detail": { "$ref": "#/$defs/character_detail" }
      },
      "additionalProperties": true
    },
    "item_observation": {
      "type": "object",
      "required": ["observation_id", "game_account_id", "kind", "collection_completeness", "entries", "provenance"],
      "properties": {
        "observation_id": { "$ref": "#/$defs/guid" },
        "game_account_id": { "$ref": "#/$defs/guid" },
        "kind": { "enum": [1, 2] },
        "collection_completeness": { "enum": [0, 1, 2] },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
        "character_metadata": { "$ref": "#/$defs/character_response_metadata" },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "additionalProperties": true
    },
    "occurrence": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": [0, 1, 2, 3] },
        "start": { "type": ["string", "null"], "format": "date-time" },
        "end": { "type": ["string", "null"], "format": "date-time" },
        "precision": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 }
      },
      "additionalProperties": true
    },
    "manual_acquisition": {
      "type": "object",
      "required": ["acquisition_id", "game_account_id", "kind", "type_id", "occurred_at", "reason", "provenance"],
      "properties": {
        "acquisition_id": { "$ref": "#/$defs/guid" },
        "game_account_id": { "$ref": "#/$defs/guid" },
        "kind": { "enum": [1, 2] },
        "type_id": { "type": "string", "minLength": 1 },
        "occurred_at": { "$ref": "#/$defs/occurrence" },
        "reason": { "enum": [0, 1, 2, 3, 4, 5] },
        "reason_detail": { "type": ["string", "null"] },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "additionalProperties": true
    },
    "revision": {
      "type": "object",
        "required": ["revision_id", "change_kind", "created_at"],
      "properties": {
        "revision_id": { "$ref": "#/$defs/guid" },
        "change_kind": { "enum": [1, 2, 3] },
        "before_version": { "type": ["integer", "null"], "minimum": 1 },
        "after_version": { "type": ["integer", "null"], "minimum": 1 },
        "before": { "oneOf": [{ "$ref": "#/$defs/manual_acquisition" }, { "type": "null" }] },
        "after": { "oneOf": [{ "$ref": "#/$defs/manual_acquisition" }, { "type": "null" }] },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "account": {
      "type": "object",
      "required": ["source_account_id", "role_identity", "item_observations", "manual_acquisitions", "manual_revisions", "challenge_observations"],
      "properties": {
        "source_account_id": { "$ref": "#/$defs/guid" },
        "role_identity": { "$ref": "#/$defs/identity" },
        "item_observations": { "type": "array", "items": { "$ref": "#/$defs/item_observation" } },
        "manual_acquisitions": { "type": "array", "items": { "$ref": "#/$defs/manual_acquisition" } },
        "manual_revisions": { "type": "array", "items": { "$ref": "#/$defs/revision" } },
        "challenge_observations": { "type": "array", "maxItems": 0 }
      },
      "additionalProperties": true
    }
  }
}
