<Window
    x:Class="FurinaChronicle.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FurinaChronicle · UI-0">
    <Grid x:Name="RootGrid" Background="Transparent">
        <NavigationView
            x:Name="Navigation"
            AlwaysShowHeader="False"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="True"
            OpenPaneLength="232"
            PaneDisplayMode="Auto"
            PaneTitle="FurinaChronicle"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="组件样例" Tag="components">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="AllApps" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="主题与材质" Tag="theme">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="View" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="UI-0 边界" Tag="scope">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Document" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.Content>
                <Grid Padding="24,20,24,16" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="SectionTitle" FontSize="28" FontWeight="SemiBold" Text="组件样例" />
                            <TextBlock
                                x:Name="SectionDescription"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="独立 WinUI 3 宿主 · 仅使用虚构数据"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock
                            x:Name="ThemeStatusText"
                            Grid.Column="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center" />
                    </Grid>

                    <CommandBar Grid.Row="1" DefaultLabelPosition="Right" IsOpen="False">
                        <AppBarButton Icon="Refresh" Label="刷新样例" Click="OnRefreshClicked">
                            <AppBarButton.KeyboardAccelerators>
                                <KeyboardAccelerator Key="F5" />
                            </AppBarButton.KeyboardAccelerators>
                        </AppBarButton>
                        <AppBarButton Icon="OpenFile" Label="选择文件" Click="OnPickFileClicked">
                            <AppBarButton.KeyboardAccelerators>
                                <KeyboardAccelerator Key="O" Modifiers="Control" />
                            </AppBarButton.KeyboardAccelerators>
                        </AppBarButton>
                        <AppBarButton Icon="Save" Label="导出样例" Click="OnExportClicked">
                            <AppBarButton.KeyboardAccelerators>
                                <KeyboardAccelerator Key="E" Modifiers="Control" />
                            </AppBarButton.KeyboardAccelerators>
                        </AppBarButton>
                        <CommandBar.SecondaryCommands>
                            <AppBarButton Icon="Help" Label="显示原生对话框" Click="OnShowDialogClicked" />
                        </CommandBar.SecondaryCommands>
                    </CommandBar>

                    <Grid Grid.Row="2" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="420" />
                            <ColumnDefinition Width="*" MinWidth="280" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="0">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Padding="16,14,16,10" Spacing="3">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="受控记录列表" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="用于验证列表、键盘选择、焦点和窄窗口布局；不读取用户数据库。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ListView
                                    x:Name="PreviewList"
                                    Grid.Row="1"
                                    IsItemClickEnabled="True"
                                    ItemClick="OnPreviewItemClicked"
                                    SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="56" Padding="16,8" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding Detail}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Text="{Binding Status}"
                                                    VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18">
                            <ScrollViewer>
                                <StackPanel Spacing="14">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="原生交互" />
                                    <ComboBox
                                        x:Name="ThemeSelector"
                                        Header="应用主题"
                                        SelectedIndex="0"
                                        SelectionChanged="OnThemeSelectionChanged">
                                        <ComboBoxItem Content="跟随系统" Tag="Default" />
                                        <ComboBoxItem Content="浅色" Tag="Light" />
                                        <ComboBoxItem Content="深色" Tag="Dark" />
                                    </ComboBox>
                                    <ToggleSwitch
                                        x:Name="SolidFallbackToggle"
                                        Header="材质回退"
                                        OffContent="请求 Mica"
                                        OnContent="强制纯色"
                                        Toggled="OnSolidFallbackToggled" />
                                    <TextBlock
                                        x:Name="BackdropStatusText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                    <Button
                                        x:Name="OpenDialogButton"
                                        Content="打开 ContentDialog"
                                        Click="OnShowDialogClicked"
                                        HorizontalAlignment="Stretch" />
                                    <Button Content="打开 Flyout 菜单" HorizontalAlignment="Stretch">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="模拟刷新" Click="OnMenuActionClicked" />
                                                <MenuFlyoutItem Text="模拟导入" Click="OnMenuActionClicked" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="关闭菜单（Esc）" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="测试数据隔离路径（仅展示，不创建）"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="IsolationPathText"
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        IsTextSelectionEnabled="True"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <InfoBar
                        x:Name="StatusInfoBar"
                        Grid.Row="3"
                        IsClosable="False"
                        IsOpen="True"
                        Message="UI-0 技术小样已就绪。"
                        Severity="Informational"
                        Title="状态" />
                </Grid>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
