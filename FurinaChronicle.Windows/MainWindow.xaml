<Window
    x:Class="FurinaChronicle.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FurinaChronicle.Windows"
    Title="FurinaChronicle">
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid x:Name="StartupHost" />

        <NavigationView
            x:Name="Navigation"
            Visibility="Collapsed"
            AlwaysShowHeader="False"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="True"
            OpenPaneLength="232"
            CompactModeThresholdWidth="800"
            ExpandedModeThresholdWidth="1280"
            PaneDisplayMode="Auto"
            PaneTitle="FurinaChronicle"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="OverviewDestination" Content="概览" Tag="overview"
                    AutomationProperties.AutomationId="Ui4NavigationOverview">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ChronicleDestination" Content="游戏历程"
                    Tag="chronicle"
                    AutomationProperties.AutomationId="Ui4NavigationChronicle">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Clock" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="GachaDestination" Content="数据 · 抽卡" Tag="gacha"
                    AutomationProperties.AutomationId="Ui1Navigation">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="List" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="CharactersDestination" Content="数据 · 角色与武器"
                    Tag="characters"
                    AutomationProperties.AutomationId="Ui4NavigationCharacters">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="People" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ChallengesDestination" Content="数据 · 周期挑战"
                    Tag="challenges"
                    AutomationProperties.AutomationId="Ui4NavigationChallenges">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Flag" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="ArchiveDestination" Content="档案与账号" Tag="archives"
                    AutomationProperties.AutomationId="Ui4NavigationArchives">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Folder" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="HistoryDestination" Content="操作历史"
                    Tag="history"
                    AutomationProperties.AutomationId="Ui4NavigationHistory">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Repair" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="PassportDestination" Content="登录账号（待交付）"
                    Tag="passport" IsEnabled="False"
                    AutomationProperties.AutomationId="Ui4NavigationPassport">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Contact" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SettingsDestination" Content="设置"
                    Tag="settings"
                    AutomationProperties.AutomationId="Ui4NavigationSettings">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <NavigationView.Content>
                <Grid x:Name="PageHost">
                    <local:Ui1GachaView x:Name="GachaView" Visibility="Collapsed" />
                </Grid>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
