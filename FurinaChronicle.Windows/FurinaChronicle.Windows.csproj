<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Version.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>FurinaChronicle.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference
      Include="Microsoft.WindowsAppSDK"
      Version="2.5.1"
      GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <None
      Include="$(PkgMicrosoft_WindowsAppSDK)\license.txt"
      Link="Licenses\Microsoft.WindowsAppSDK-LICENSE.txt"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest" />
    <None
      Include="$(PkgMicrosoft_WindowsAppSDK)\NOTICE.txt"
      Link="Licenses\Microsoft.WindowsAppSDK-NOTICE.txt"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FurinaChronicle.Core\FurinaChronicle.Core.csproj" />
    <ProjectReference Include="..\FurinaChronicle.Services\FurinaChronicle.Services.csproj" />
    <ProjectReference Include="..\FurinaChronicle.Infrastructure\FurinaChronicle.Infrastructure.csproj" />
  </ItemGroup>

  <Import Project="..\build\FurinaVersion.targets" />
</Project>
