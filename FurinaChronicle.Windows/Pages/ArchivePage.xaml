<UserControl
    x:Class="FurinaChronicle.Windows.Pages.ArchivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="Ui4ArchivePage">
    <Grid Padding="24" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="档案与账号" FontSize="28" FontWeight="SemiBold" />
            <TextBlock
                Text="管理隔离库中的档案与游戏账号副本；选择只属于本页，不写入全局当前账号。"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="2">
            <TextBlock
                x:Name="StatusText"
                TextWrapping="Wrap"
                AutomationProperties.AutomationId="Ui4ManagementStatus"
                AutomationProperties.LiveSetting="Polite" />
            <TextBlock
                x:Name="ErrorText"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed"
                AutomationProperties.AutomationId="Ui4ManagementError" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="档案" FontSize="18" FontWeight="SemiBold" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CreateArchiveButton" Content="新建档案" Click="OnCreateArchive"
                        AutomationProperties.AutomationId="Ui4CreateArchive" />
                    <Button x:Name="RenameArchiveButton" Content="重命名" Click="OnRenameArchive"
                        AutomationProperties.AutomationId="Ui4RenameArchive" />
                    <Button x:Name="DeleteArchiveButton" Content="删除档案" Click="OnDeleteArchive"
                        AutomationProperties.AutomationId="Ui4DeleteArchive" />
                </StackPanel>
                <ListView
                    x:Name="ArchiveList"
                    Grid.Row="2"
                    SelectionMode="Single"
                    SelectionChanged="OnArchiveSelectionChanged"
                    AutomationProperties.AutomationId="Ui4ArchiveList">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="8,6" Spacing="2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Name="SelectedArchiveText"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="未选择档案"
                    TextWrapping="Wrap"
                    AutomationProperties.AutomationId="Ui4SelectedArchive" />
                <Border
                    x:Name="UnresolvedBanner"
                    Grid.Row="1"
                    Padding="10"
                    CornerRadius="6"
                    Visibility="Collapsed"
                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                    AutomationProperties.AutomationId="Ui4UnresolvedBanner">
                    <TextBlock
                        x:Name="UnresolvedText"
                        TextWrapping="Wrap"
                        AutomationProperties.AutomationId="Ui4UnresolvedText" />
                </Border>
                <ListView
                    x:Name="AccountList"
                    Grid.Row="2"
                    SelectionMode="Single"
                    SelectionChanged="OnAccountSelectionChanged"
                    AutomationProperties.AutomationId="Ui4AccountList">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="8,6" Spacing="2">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                    TextWrapping="Wrap" />
                                <TextBlock Text="{Binding IdentityStatus}" FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AddAccountButton" Content="添加账号" Click="OnAddAccount"
                        AutomationProperties.AutomationId="Ui4AddAccount" />
                    <Button x:Name="EditAccountButton" Content="编辑账号" Click="OnEditAccount"
                        AutomationProperties.AutomationId="Ui4EditAccount" />
                    <Button x:Name="DeleteAccountButton" Content="删除账号" Click="OnDeleteAccount"
                        AutomationProperties.AutomationId="Ui4DeleteAccount" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
