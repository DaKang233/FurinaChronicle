<UserControl
    x:Class="FurinaChronicle.Windows.Pages.PassportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="Ui4PassportPage">
    <ScrollViewer Padding="24">
        <StackPanel Spacing="14">
            <StackPanel Spacing="4">
                <TextBlock Text="登录账号" FontSize="28" FontWeight="SemiBold" />
                <TextBlock
                    Text="仅隔离宿主：凭据用 Windows DPAPI 加密保存到 UI4/WinUI/credentials；不连接生产库或生产凭据。生产凭据迁移待 UI-6 评审。"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    AutomationProperties.AutomationId="Ui4PassportIsolationNotice" />
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                    AutomationProperties.AutomationId="Ui4PassportStatus"
                    AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Visibility="Collapsed"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    AutomationProperties.AutomationId="Ui4PassportError" />
                <TextBlock x:Name="LoadWarningText" TextWrapping="Wrap" Visibility="Collapsed"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    AutomationProperties.AutomationId="Ui4PassportLoadWarning" />
            </StackPanel>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AddButton" Content="手动添加凭据" Click="OnAddCredential"
                            AutomationProperties.AutomationId="Ui4PassportAdd" />
                        <Button x:Name="RefreshButton" Content="刷新列表" Click="OnRefresh"
                            AutomationProperties.AutomationId="Ui4PassportRefresh" />
                    </StackPanel>
                    <ListView x:Name="CredentialList" Grid.Row="1" SelectionMode="Single"
                        SelectionChanged="OnCredentialSelectionChanged"
                        AutomationProperties.AutomationId="Ui4PassportCredentialList">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="8,6" Spacing="2">
                                    <TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold"
                                        TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding DetailLabel}" FontSize="12"
                                        TextWrapping="Wrap"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Border Grid.Column="1" Padding="16" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="DetailTitleText" FontSize="20" FontWeight="SemiBold"
                            TextWrapping="Wrap"
                            AutomationProperties.AutomationId="Ui4PassportDetailTitle" />
                        <TextBlock x:Name="DetailBodyText" TextWrapping="Wrap"
                            AutomationProperties.AutomationId="Ui4PassportDetail" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="DeleteButton" Content="删除所选凭据"
                                Click="OnDeleteCredential"
                                AutomationProperties.AutomationId="Ui4PassportDelete" />
                            <Button x:Name="ClearButton" Content="清除全部凭据"
                                Click="OnClearCredentials"
                                AutomationProperties.AutomationId="Ui4PassportClear" />
                            <Button x:Name="OpenGachaRefreshButton" Content="打开抽卡刷新入口"
                                Click="OnOpenGachaRefresh"
                                AutomationProperties.AutomationId="Ui4PassportOpenGachaRefresh" />
                        </StackPanel>
                        <TextBlock
                            Text="删除/清除只删除本机隔离宿主凭据，不删除档案、账号或抽卡事实。SToken/MID 永不回显。"
                            FontSize="12" TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Text="刷新入口：数据 · 抽卡 → 数据操作 → “通过登录账号刷新”。凭据需绑定当前档案账号 UID。"
                            FontSize="12" TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
