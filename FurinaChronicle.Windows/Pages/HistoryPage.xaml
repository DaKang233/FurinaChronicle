<UserControl
    x:Class="FurinaChronicle.Windows.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="Ui4HistoryPage">
    <Grid Padding="24" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="操作历史" FontSize="28" FontWeight="SemiBold" />
            <TextBlock
                Text="按档案查看最近操作、撤销资格与修订；撤销仅作用于最新可撤销项，本页不提供热回切。"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="ArchivePicker"
                Header="档案"
                DisplayMemberPath="Name"
                HorizontalAlignment="Stretch"
                SelectionChanged="OnArchiveSelectionChanged"
                AutomationProperties.AutomationId="Ui4HistoryArchivePicker" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <NumberBox
                    x:Name="UndoLimitBox"
                    Header="撤销保留次数（0～1000）"
                    Minimum="0"
                    Maximum="1000"
                    SmallChange="1"
                    SpinButtonPlacementMode="Compact"
                    AutomationProperties.AutomationId="Ui4HistoryUndoLimit" />
                <Button x:Name="ApplyUndoLimitButton" Content="应用" Click="OnApplyUndoLimit"
                    AutomationProperties.AutomationId="Ui4HistoryApplyUndoLimit" />
            </StackPanel>
            <Button
                x:Name="UndoLatestButton"
                Grid.Column="2"
                Content="撤销最新可撤销操作"
                VerticalAlignment="Bottom"
                Click="OnUndoLatest"
                AutomationProperties.AutomationId="Ui4HistoryUndoLatest" />
            <Button
                x:Name="ReloadButton"
                Grid.Column="3"
                Content="刷新"
                VerticalAlignment="Bottom"
                Click="OnReload"
                AutomationProperties.AutomationId="Ui4HistoryReload" />
        </Grid>

        <StackPanel Grid.Row="2" Spacing="2">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                AutomationProperties.AutomationId="Ui4HistoryStatus"
                AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Visibility="Collapsed"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                AutomationProperties.AutomationId="Ui4HistoryError" />
        </StackPanel>

        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <ListView
                x:Name="HistoryList"
                SelectionMode="Single"
                SelectionChanged="OnHistorySelectionChanged"
                AutomationProperties.AutomationId="Ui4HistoryList">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="8,6" Spacing="3">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Operation}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding Summary}"
                                    TextWrapping="Wrap" />
                                <TextBlock Grid.Column="2" Text="{Binding Affected}" />
                            </Grid>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding CommittedAt}" FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Scope}" FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding Reversibility}" FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="3" Text="{Binding UndoState}" FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Column="1" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="RevisionStatusText" FontWeight="SemiBold" TextWrapping="Wrap"
                    AutomationProperties.AutomationId="Ui4HistoryRevisionStatus" />
                <ListView x:Name="RevisionList" Grid.Row="1" SelectionMode="None"
                    AutomationProperties.AutomationId="Ui4HistoryRevisions">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="8,6" Spacing="3">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}"
                                        TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="2" Text="{Binding Change}" />
                                </Grid>
                                <TextBlock Text="{Binding Before}" FontSize="12"
                                    TextWrapping="Wrap"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding After}" FontSize="12"
                                    TextWrapping="Wrap"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding CreatedAt}" FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Note}" FontSize="12" TextWrapping="Wrap"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
