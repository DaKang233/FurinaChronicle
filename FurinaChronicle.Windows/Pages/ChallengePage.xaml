<UserControl
    x:Class="FurinaChronicle.Windows.Pages.ChallengePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="Ui5ChallengePage">
    <Grid Padding="24" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="周期挑战" FontSize="28" FontWeight="SemiBold" />
            <TextBlock
                Text="深境螺旋、幻想真境剧诗与幽境危战的历史观察。默认显示最新观察，可切换期次与历史观察；缺失字段保持未知。"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="ArchivePicker"
                Header="档案"
                DisplayMemberPath="Label"
                HorizontalAlignment="Stretch"
                SelectionChanged="OnArchiveSelectionChanged"
                AutomationProperties.AutomationId="Ui5ChallengeArchivePicker" />
            <ComboBox
                x:Name="AccountPicker"
                Grid.Column="1"
                Header="账号"
                DisplayMemberPath="Label"
                HorizontalAlignment="Stretch"
                SelectionChanged="OnAccountSelectionChanged"
                AutomationProperties.AutomationId="Ui5ChallengeAccountPicker" />
            <ComboBox
                x:Name="ModePicker"
                Grid.Column="2"
                Header="模式"
                MinWidth="150"
                SelectionChanged="OnModeSelectionChanged"
                AutomationProperties.AutomationId="Ui5ChallengeModePicker" />
            <ComboBox
                x:Name="SeasonPicker"
                Grid.Column="3"
                Header="期次"
                MinWidth="130"
                SelectionChanged="OnSeasonSelectionChanged"
                AutomationProperties.AutomationId="Ui5ChallengeSeasonPicker" />
            <Button
                x:Name="ReloadButton"
                Grid.Column="4"
                Content="刷新"
                VerticalAlignment="Bottom"
                Click="OnReload"
                AutomationProperties.AutomationId="Ui5ChallengeReload" />
            <StackPanel
                Grid.Column="5"
                Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Bottom">
                <Button
                    x:Name="PreviousButton"
                    Content="上一页"
                    Click="OnPrevious"
                    AutomationProperties.AutomationId="Ui5ChallengePrevious" />
                <Button
                    x:Name="NextButton"
                    Content="下一页"
                    Click="OnNext"
                    AutomationProperties.AutomationId="Ui5ChallengeNext" />
            </StackPanel>
            <TextBlock
                x:Name="PageText"
                Grid.Column="7"
                VerticalAlignment="Bottom"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                AutomationProperties.AutomationId="Ui5ChallengePaging" />
        </Grid>

        <StackPanel Grid.Row="2" Spacing="3">
            <TextBlock
                x:Name="StatusText"
                TextWrapping="Wrap"
                AutomationProperties.AutomationId="Ui5ChallengeStatus"
                AutomationProperties.LiveSetting="Polite" />
            <TextBlock
                x:Name="ErrorText"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed"
                AutomationProperties.AutomationId="Ui5ChallengeError" />
            <TextBlock
                x:Name="EmptyText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed"
                AutomationProperties.AutomationId="Ui5ChallengeEmpty" />
        </StackPanel>

        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <ListView
                x:Name="ObservationList"
                SelectionMode="Single"
                SelectionChanged="OnObservationSelectionChanged"
                AutomationProperties.AutomationId="Ui5ChallengeObservationList">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="8,6" Spacing="3">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock
                                Text="{Binding Evidence}"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <TextBlock Text="{Binding OccurredText}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Name="DetailTitleText"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap"
                    AutomationProperties.AutomationId="Ui5ChallengeDetailTitle" />
                <ScrollViewer Grid.Row="1">
                    <TextBlock
                        x:Name="DetailBodyText"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"
                        AutomationProperties.AutomationId="Ui5ChallengeDetail" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
