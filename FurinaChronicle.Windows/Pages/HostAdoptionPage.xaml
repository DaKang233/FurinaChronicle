<UserControl
    x:Class="FurinaChronicle.Windows.Pages.HostAdoptionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="Ui6HostAdoptionPage">
    <ScrollViewer Padding="24">
        <StackPanel Spacing="14" MaxWidth="1100">
            <StackPanel Spacing="4">
                <TextBlock Text="使用现有数据（同一数据库）" FontSize="28" FontWeight="SemiBold" />
                <TextBlock
                    Text="WinUI 将直接打开 MAUI 宿主使用的同一个 furinachronicle.db3；不复制、不移动、不切换路径。接管前强制备份，失败不写标记、不改原库。"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    AutomationProperties.AutomationId="Ui6AdoptionIntro" />
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                    AutomationProperties.AutomationId="Ui6AdoptionStatus"
                    AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Visibility="Collapsed"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    AutomationProperties.AutomationId="Ui6AdoptionError" />
                <ProgressRing x:Name="Progress" IsActive="False" Width="24" Height="24" />
            </StackPanel>

            <Border Padding="16" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="6">
                    <TextBlock Text="只读探测" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="DatabaseText" TextWrapping="Wrap"
                        AutomationProperties.AutomationId="Ui6AdoptionDatabase" />
                    <TextBlock x:Name="BackupText" TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        AutomationProperties.AutomationId="Ui6AdoptionBackup" />
                    <TextBlock x:Name="MarkerText" TextWrapping="Wrap"
                        AutomationProperties.AutomationId="Ui6AdoptionMarker" />
                    <TextBlock x:Name="LegacyText" TextWrapping="Wrap" Visibility="Collapsed"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        AutomationProperties.AutomationId="Ui6AdoptionLegacy" />
                </StackPanel>
            </Border>

            <Border Padding="16" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="接管操作" FontSize="18" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AdoptButton" Content="接管现有数据（同一数据库）"
                            Click="OnAdopt"
                            AutomationProperties.AutomationId="Ui6AdoptionAdopt" />
                        <Button x:Name="InitializeButton" Content="初始化新生产库（不播种）"
                            Click="OnInitialize"
                            AutomationProperties.AutomationId="Ui6AdoptionInitialize" />
                        <Button x:Name="RetryButton" Content="重新探测"
                            Click="OnRetry"
                            AutomationProperties.AutomationId="Ui6AdoptionRetry" />
                    </StackPanel>
                    <TextBlock
                        Text="接管流程：只读校验 application_id/Schema/quick_check → 强制备份到生产数据目录 Backups/ → 写脱敏接管标记 UI6/host-adoption.json → 以同一路径进入应用。"
                        FontSize="12" TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border Padding="16" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="6">
                    <TextBlock Text="回退与凭据边界" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="RollbackText" TextWrapping="Wrap"
                        AutomationProperties.AutomationId="Ui6AdoptionRollback" />
                    <TextBlock
                        Text="WinUI 与 MAUI 不可同时运行同一数据库。接管后如需回退：关闭 WinUI，直接用旧 MAUI 打开原库；不要删除原库或 Backups。"
                        FontSize="12" TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
