<UserControl
    x:Class="FurinaChronicle.Windows.Pages.CharacterWeaponPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="Ui5CharacterWeaponPage">
    <Grid Padding="24" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="角色与武器" FontSize="28" FontWeight="SemiBold" />
            <TextBlock
                Text="查看已保存的角色/武器状态观察。默认显示最新观察，可切换历史观察；缺失等级或命座保持未知，不推断。"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="ArchivePicker"
                Header="档案"
                DisplayMemberPath="Label"
                HorizontalAlignment="Stretch"
                SelectionChanged="OnArchiveSelectionChanged"
                AutomationProperties.AutomationId="Ui5CharacterWeaponArchivePicker" />
            <ComboBox
                x:Name="AccountPicker"
                Grid.Column="1"
                Header="账号"
                DisplayMemberPath="Label"
                HorizontalAlignment="Stretch"
                SelectionChanged="OnAccountSelectionChanged"
                AutomationProperties.AutomationId="Ui5CharacterWeaponAccountPicker" />
            <ComboBox
                x:Name="KindPicker"
                Grid.Column="2"
                Header="类别"
                MinWidth="110"
                SelectionChanged="OnKindSelectionChanged"
                AutomationProperties.AutomationId="Ui5CharacterWeaponKindPicker" />
            <Button
                x:Name="ReloadButton"
                Grid.Column="3"
                Content="刷新"
                VerticalAlignment="Bottom"
                Click="OnReload"
                AutomationProperties.AutomationId="Ui5CharacterWeaponReload" />
            <StackPanel
                Grid.Column="4"
                Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Bottom">
                <Button
                    x:Name="PreviousButton"
                    Content="上一页"
                    Click="OnPrevious"
                    AutomationProperties.AutomationId="Ui5CharacterWeaponPrevious" />
                <Button
                    x:Name="NextButton"
                    Content="下一页"
                    Click="OnNext"
                    AutomationProperties.AutomationId="Ui5CharacterWeaponNext" />
            </StackPanel>
            <TextBlock
                x:Name="PageText"
                Grid.Column="5"
                VerticalAlignment="Bottom"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                AutomationProperties.AutomationId="Ui5CharacterWeaponPaging" />
        </Grid>

        <StackPanel Grid.Row="2" Spacing="3">
            <TextBlock
                x:Name="StatusText"
                TextWrapping="Wrap"
                AutomationProperties.AutomationId="Ui5CharacterWeaponStatus"
                AutomationProperties.LiveSetting="Polite" />
            <TextBlock
                x:Name="ErrorText"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed"
                AutomationProperties.AutomationId="Ui5CharacterWeaponError" />
            <TextBlock
                x:Name="EmptyText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed"
                AutomationProperties.AutomationId="Ui5CharacterWeaponEmpty" />
        </StackPanel>

        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <ListView
                x:Name="ObservationList"
                SelectionMode="Single"
                SelectionChanged="OnObservationSelectionChanged"
                AutomationProperties.AutomationId="Ui5CharacterWeaponObservationList">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="8,6" Spacing="3">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock
                                Text="{Binding Evidence}"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ObservedText}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Name="DetailTitleText"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap"
                    AutomationProperties.AutomationId="Ui5CharacterWeaponDetailTitle" />
                <ScrollViewer Grid.Row="1">
                    <TextBlock
                        x:Name="DetailBodyText"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"
                        AutomationProperties.AutomationId="Ui5CharacterWeaponDetail" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
