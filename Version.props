<Project>
  <!--
    This is the only manually maintained application-version source.
    Git-derived values are resolved by build/FurinaVersion.targets and are
    never written back to this file.
  -->
  <PropertyGroup>
    <FurinaVersionMajor Condition="'$(FurinaVersionMajor)' == ''">0</FurinaVersionMajor>
    <FurinaVersionMinor Condition="'$(FurinaVersionMinor)' == ''">10</FurinaVersionMinor>
    <FurinaVersionPatch Condition="'$(FurinaVersionPatch)' == ''">0</FurinaVersionPatch>
    <FurinaPhaseLabel Condition="'$(FurinaPhaseLabel)' == ''">10.0</FurinaPhaseLabel>

    <FurinaVersionPrefix>$(FurinaVersionMajor).$(FurinaVersionMinor).$(FurinaVersionPatch)</FurinaVersionPrefix>
    <FurinaRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))</FurinaRepositoryRoot>
    <ApplicationDisplayVersion>$(FurinaVersionPrefix)</ApplicationDisplayVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
