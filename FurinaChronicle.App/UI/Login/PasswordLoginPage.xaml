<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FurinaChronicle.App.PasswordLoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="账号密码登录">
    <Grid RowDefinitions="Auto,*">
        <Label x:Name="StatusLabel" Padding="12,8" Text="请在米哈游官方页面完成登录；应用不会读取或保存密码。" />
        <WebView
            x:Name="PassportWebView"
            Grid.Row="1"
            Navigated="OnPassportWebViewNavigated" />
    </Grid>
</ContentPage>
