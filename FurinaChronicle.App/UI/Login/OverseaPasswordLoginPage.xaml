<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FurinaChronicle.App.OverseaPasswordLoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="HoYoLAB 账号密码登录">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Button HorizontalOptions="Start" Text="← 返回上一级" Clicked="OnBackClicked" />
            <Label FontAttributes="Bold" FontSize="22" Text="HoYoLAB 海外通行证登录" />
            <Label
                FontSize="12"
                Text="仅用于 HoYoverse/HoYoLAB 海外账号。账号和密码经 RSA 加密后直接提交给 HoYoverse，应用不会保存密码。" />
            <Entry x:Name="AccountEntry" Placeholder="邮箱或 HoYoLAB 账号" />
            <Entry x:Name="PasswordEntry" IsPassword="True" Placeholder="密码" />
            <Button x:Name="LoginButton" Text="登录" Clicked="OnLoginClicked" />
            <ActivityIndicator x:Name="BusyIndicator" IsVisible="False" />
            <Label x:Name="StatusLabel" FontSize="12" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
