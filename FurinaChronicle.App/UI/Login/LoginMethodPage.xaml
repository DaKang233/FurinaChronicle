<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FurinaChronicle.App.LoginMethodPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="选择登录方式">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Button HorizontalOptions="Start" Text="← 返回上一级" Clicked="OnBackClicked" />
            <Label FontAttributes="Bold" FontSize="24" Text="登录米哈游通行证" />
            <Label FontSize="12" Text="登录成功后会自动返回用户页。密码不会保存到 FurinaChronicle。" />
            <Button Text="HoYoLAB 海外账号密码登录" Clicked="OnPasswordClicked" />
            <Button Text="米游社 APP 扫码" Clicked="OnQrClicked" />
            <Button Text="手机验证码登录" Clicked="OnMobileClicked" />
            <Button Text="手动输入 Cookie" Clicked="OnCookieClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
