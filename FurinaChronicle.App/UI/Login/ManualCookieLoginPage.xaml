<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FurinaChronicle.App.ManualCookieLoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="手动输入 Cookie">
    <Grid Padding="20" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
        <Label Text="粘贴包含 account_id/ltuid 和可用 Token 的米游社 Cookie。" />
        <Editor x:Name="CookieEditor" Grid.Row="1" AutoSize="TextChanges" Placeholder="account_id=...; stoken=...; mid=..." />
        <Button Grid.Row="2" Text="登录并保存" Clicked="OnLoginClicked" />
        <Label x:Name="StatusLabel" Grid.Row="3" FontSize="12" TextColor="Red" />
    </Grid>
</ContentPage>
