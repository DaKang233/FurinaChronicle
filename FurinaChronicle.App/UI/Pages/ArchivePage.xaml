<ContentPage
    x:Class="FurinaChronicle.App.UI.Pages.ArchivePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:FurinaChronicle.App.UI.Controls"
    xmlns:viewModels="clr-namespace:FurinaChronicle.App.ViewModels"
    x:DataType="viewModels:ArchivePageViewModel"
    Title="档案与账号管理">

    <Shell.TitleView>
        <controls:PassportAvatarButton
            IsVisible="{OnPlatform Android=True, WinUI=False}" />
    </Shell.TitleView>

    <ScrollView VerticalScrollBarVisibility="Always">
        <VerticalStackLayout Padding="16" Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <VerticalStackLayout Spacing="2">
                    <Label FontAttributes="Bold" FontSize="24" Text="档案与账号管理" />
                    <Label
                        FontSize="12"
                        Opacity="0.7"
                        Text="管理本地玩家档案及其游戏账号。各业务页面保留自己的查看选择。" />
                </VerticalStackLayout>
                <Button
                    Grid.Column="1"
                    Command="{Binding ReloadCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Text="重新加载" />
            </Grid>

            <Border Padding="14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Spacing="2">
                        <Label FontAttributes="Bold" FontSize="18" Text="备份与恢复" />
                        <Label
                            FontSize="12"
                            Opacity="0.7"
                            Text="导出完整逻辑 Archive，或在完整 Preview 后执行 Merge / Scoped Replace。" />
                    </VerticalStackLayout>
                    <Button
                        Grid.Column="1"
                        Clicked="OnOpenBackupRestoreClicked"
                        IsEnabled="{Binding IsNotBusy}"
                        Text="打开" />
                </Grid>
            </Border>

            <Border Padding="14">
                <VerticalStackLayout Spacing="10">
                    <Label FontAttributes="Bold" FontSize="18" Text="更多入口" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="2">
                            <Label FontAttributes="Bold" Text="操作历史 / 修改历史" />
                            <Label
                                FontSize="12"
                                Opacity="0.7"
                                Text="查看当前档案的操作记录与事实修订，管理可撤销项；与设置页共用撤销保留次数。" />
                        </VerticalStackLayout>
                        <Button
                            Grid.Column="1"
                            Clicked="OnOpenArchiveHistoryClicked"
                            IsEnabled="{Binding IsNotBusy}"
                            Text="打开"
                            AutomationId="OpenArchiveHistory" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="2">
                            <Label FontAttributes="Bold" Text="用户与登录" />
                            <Label
                                FontSize="12"
                                Opacity="0.7"
                                Text="米哈游通行证登录、角色选择与退出凭据（退出登录不删除本地档案）。" />
                        </VerticalStackLayout>
                        <Button
                            Grid.Column="1"
                            Clicked="OnOpenUserPageClicked"
                            IsEnabled="{Binding IsNotBusy}"
                            Text="打开"
                            AutomationId="OpenUserPage" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="2">
                            <Label FontAttributes="Bold" Text="设置" />
                            <Label
                                FontSize="12"
                                Opacity="0.7"
                                Text="外观、数据与存储、撤销保留次数、应用信息与本地诊断。" />
                        </VerticalStackLayout>
                        <Button
                            Grid.Column="1"
                            Clicked="OnOpenSettingsClicked"
                            IsEnabled="{Binding IsNotBusy}"
                            Text="打开"
                            AutomationId="OpenSettings" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Padding="14">
                <VerticalStackLayout Spacing="10">
                    <Label FontAttributes="Bold" FontSize="18" Text="档案" />
                    <Picker
                        Title="选择档案"
                        IsEnabled="{Binding IsNotBusy}"
                        ItemsSource="{Binding Archives}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedIndexChanged="OnArchiveSelectionChanged"
                        SelectedItem="{Binding SelectedArchive, Mode=TwoWay}" />
                    <ScrollView HorizontalScrollBarVisibility="Default" Orientation="Horizontal">
                        <HorizontalStackLayout Spacing="8">
                            <Button
                                Clicked="OnCreateArchiveClicked"
                                IsEnabled="{Binding IsNotBusy}"
                                Text="创建档案" />
                            <Button
                                Clicked="OnRenameArchiveClicked"
                                IsEnabled="{Binding IsNotBusy}"
                                Text="重命名档案" />
                            <Button
                                Clicked="OnDeleteArchiveClicked"
                                IsEnabled="{Binding IsNotBusy}"
                                Text="删除档案" />
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>
            </Border>

            <Border Padding="14">
                <VerticalStackLayout Spacing="10">
                    <Label FontAttributes="Bold" FontSize="18" Text="游戏账号" />
                    <Picker
                        Title="选择当前档案中的游戏账号"
                        IsEnabled="{Binding IsNotBusy}"
                        ItemsSource="{Binding Accounts}"
                        ItemDisplayBinding="{Binding DisplayName}"
                        SelectedIndexChanged="OnAccountSelectionChanged"
                        SelectedItem="{Binding SelectedAccount, Mode=TwoWay}" />
                    <ScrollView HorizontalScrollBarVisibility="Default" Orientation="Horizontal">
                        <HorizontalStackLayout Spacing="8">
                            <Button
                                Clicked="OnEditAccountClicked"
                                IsEnabled="{Binding IsNotBusy}"
                                Text="编辑所选账号" />
                            <Button
                                Clicked="OnDeleteAccountClicked"
                                IsEnabled="{Binding IsNotBusy}"
                                Text="删除所选账号" />
                        </HorizontalStackLayout>
                    </ScrollView>

                    <BoxView HeightRequest="1" Opacity="0.25" />
                    <Label FontAttributes="Bold" Text="添加游戏账号" />
                    <Grid
                        ColumnDefinitions="2*,*,2*"
                        ColumnSpacing="8"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="8">
                        <Entry
                            Grid.ColumnSpan="2"
                            Keyboard="Numeric"
                            MaxLength="12"
                            Placeholder="游戏账号 UID"
                            Text="{Binding NewAccountUid}" />
                        <Picker
                            Grid.Column="2"
                            Title="服务器"
                            ItemsSource="{Binding ServerRegions}"
                            SelectedItem="{Binding SelectedServerRegion}" />
                        <Entry
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            MaxLength="50"
                            Placeholder="账号备注（可选）"
                            Text="{Binding NewAccountDisplayName}" />
                        <Button
                            Grid.Row="1"
                            Grid.Column="2"
                            Clicked="OnCreateAccountClicked"
                            IsEnabled="{Binding IsNotBusy}"
                            Text="添加账号" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <VerticalStackLayout Spacing="2">
                    <Label FontSize="12" Text="{Binding StatusMessage}" />
                    <Label FontSize="12" Text="{Binding ErrorMessage}" TextColor="Red" />
                </VerticalStackLayout>
                <ActivityIndicator
                    Grid.Column="1"
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
