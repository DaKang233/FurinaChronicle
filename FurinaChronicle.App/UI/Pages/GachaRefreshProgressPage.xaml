<ContentPage
    x:Class="FurinaChronicle.App.UI.Pages.GachaRefreshProgressPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:gacha="clr-namespace:FurinaChronicle.App.UI.Gacha"
    xmlns:viewModels="clr-namespace:FurinaChronicle.App.ViewModels"
    x:DataType="viewModels:GachaPageViewModel"
    Shell.NavBarIsVisible="False"
    Title="刷新抽卡记录">

    <Grid Padding="18" RowDefinitions="*,Auto" RowSpacing="12">
        <gacha:GachaRefreshProgressView />
        <!-- A failed refresh stays on screen (with its reason) until dismissed. -->
        <Button
            Grid.Row="1"
            Clicked="OnCloseClicked"
            IsVisible="{Binding IsRefreshFailed}"
            Text="关闭" />
    </Grid>
</ContentPage>
