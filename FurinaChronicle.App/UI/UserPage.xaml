<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FurinaChronicle.App.UserPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:FurinaChronicle.App.ViewModels"
    xmlns:passport="clr-namespace:FurinaChronicle.Services.Passport;assembly=FurinaChronicle.Services"
    x:DataType="viewModels:UserPageViewModel"
    Title="用户">
    <Grid Padding="20" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="2">
                <Label FontAttributes="Bold" FontSize="26" Text="米哈游通行证" />
                <Label FontSize="12" Text="管理登录账号和当前原神角色" />
            </VerticalStackLayout>
            <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </Grid>

        <Border Grid.Row="1" Padding="14">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                    <Button Text="登录" Clicked="OnLoginClicked" IsEnabled="{Binding IsNotBusy}" />
                    <Button Grid.Column="1" Text="删除所选账号" Clicked="OnDeleteClicked" IsEnabled="{Binding HasSelectedAccount}" />
                    <Button Grid.Column="2" HorizontalOptions="End" Text="重新加载" Clicked="OnReloadClicked" IsEnabled="{Binding IsNotBusy}" />
                </Grid>

                <Picker
                    Title="选择米哈游通行证账号"
                    ItemsSource="{Binding Accounts}"
                    SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                    SelectedIndexChanged="OnAccountSelectionChanged">
                    <Picker.ItemDisplayBinding>
                        <Binding Path="DisplayName" />
                    </Picker.ItemDisplayBinding>
                </Picker>
            </VerticalStackLayout>
        </Border>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Accounts}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Padding="20" HorizontalTextAlignment="Center" Text="尚未保存米哈游通行证账号。" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:PassportAccountListItem">
                    <Border Margin="0,0,0,8" Padding="12">
                        <Grid ColumnDefinitions="52,*" ColumnSpacing="12">
                            <Border HeightRequest="48" WidthRequest="48" StrokeShape="RoundRectangle 24">
                                <Grid>
                                    <Label FontSize="22" HorizontalTextAlignment="Center" Text="👤" VerticalTextAlignment="Center" />
                                    <Image Aspect="AspectFill" IsVisible="{Binding HasAvatar}" Source="{Binding AvatarUrl}" />
                                </Grid>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label FontAttributes="Bold" Text="{Binding DisplayName}" />
                                <Label FontSize="11" Text="{Binding Aid, StringFormat='AID {0}'}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="3" Padding="14">
            <VerticalStackLayout Spacing="8">
                <Label FontAttributes="Bold" Text="当前原神角色" />
                <Picker
                    Title="选择角色"
                    ItemsSource="{Binding Roles}"
                    SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
                    SelectedIndexChanged="OnRoleSelectionChanged">
                    <Picker.ItemDisplayBinding>
                        <Binding Path="DisplayName" />
                    </Picker.ItemDisplayBinding>
                </Picker>
                <Label FontSize="12" Text="{Binding StatusMessage}" />
                <Label FontSize="12" Text="{Binding ErrorMessage}" TextColor="Red" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
