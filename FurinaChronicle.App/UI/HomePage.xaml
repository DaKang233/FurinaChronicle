<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FurinaChronicle.App.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:FurinaChronicle.App.UI.Controls"
    Title="主页">
    <Shell.TitleView>
        <controls:PassportAvatarButton
            IsVisible="{OnPlatform Android=True, WinUI=False}" />
    </Shell.TitleView>
    <Grid Padding="24">
        <VerticalStackLayout HorizontalOptions="Center" Spacing="8" VerticalOptions="Center">
            <Label FontAttributes="Bold" FontSize="30" HorizontalTextAlignment="Center" Text="FurinaChronicle" />
            <Label HorizontalTextAlignment="Center" Opacity="0.65" Text="主页内容将在后续版本加入。" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
