<ContentView
    x:Class="FurinaChronicle.App.UI.Gacha.AccountGachaView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:FurinaChronicle.App.ViewModels"
    x:DataType="viewModels:GachaAnalysisViewModel">

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
        <Border Padding="10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label FontAttributes="Bold" Text="账号数据" VerticalTextAlignment="Center" />
                <Label
                    Grid.Column="1"
                    FontSize="12"
                    Text="{Binding ScopeDescription}"
                    VerticalTextAlignment="Center" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" Orientation="Horizontal">
            <HorizontalStackLayout Spacing="8">
                <Button Command="{Binding ShowOverviewCommand}" IsEnabled="{Binding IsNotBusy}" Text="数据总览" />
                <Button Command="{Binding ShowDetailsCommand}" IsEnabled="{Binding IsNotBusy}" Text="明细表格" />
                <Button Command="{Binding ShowHistoryCommand}" IsEnabled="{Binding IsNotBusy}" Text="抽卡历史" />
                <Button Command="{Binding ShowCalendarCommand}" IsEnabled="{Binding IsNotBusy}" Text="抽卡日历" />
                <Button Command="{Binding ShowItemsCommand}" IsEnabled="{Binding IsNotBusy}" Text="物品" />
            </HorizontalStackLayout>
        </ScrollView>

        <ContentView x:Name="AnalysisPageHost" Grid.Row="2" />
    </Grid>
</ContentView>
