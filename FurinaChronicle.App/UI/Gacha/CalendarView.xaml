<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="FurinaChronicle.App.UI.Gacha.CalendarView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:FurinaChronicle.App.ViewModels"
    x:DataType="viewModels:GachaAnalysisViewModel">

    <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <VerticalStackLayout>
            <Label FontAttributes="Bold" FontSize="20" Text="抽卡日历" />
            <Label FontSize="11" Text="颜色越深表示当天投入的抽数越多。" />
        </VerticalStackLayout>
        <CollectionView Grid.Row="1" ItemsSource="{Binding CalendarItems}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="7" HorizontalItemSpacing="5" VerticalItemSpacing="5" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <Label Padding="16" Text="当前范围暂无日历数据。" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:WishCalendarDisplayItem">
                    <Border BackgroundColor="{Binding Color}" Padding="7" MinimumHeightRequest="72">
                        <VerticalStackLayout Spacing="2">
                            <Label FontAttributes="Bold" FontSize="11" Text="{Binding Date}" TextColor="Black" />
                            <Label FontSize="11" Text="{Binding Total}" TextColor="Black" />
                            <Label FontSize="9" LineBreakMode="WordWrap" Text="{Binding HighRanks}" TextColor="Black" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentView>
