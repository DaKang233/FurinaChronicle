<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="FurinaChronicle.App.UI.Gacha.ItemsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:FurinaChronicle.App.ViewModels"
    x:DataType="viewModels:GachaAnalysisViewModel">

    <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Label FontAttributes="Bold" FontSize="20" Text="物品" />
            <Button Grid.Column="1" Command="{Binding UseItemGridCommand}" Text="图标网格" />
            <Button
                Grid.Column="2"
                Command="{Binding UseItemListCommand}"
                IsEnabled="{Binding CanUseItemListMode}"
                Text="列表与时间" />
        </Grid>

        <ScrollView
            Grid.Row="1"
            IsVisible="{Binding IsItemGridMode}">
            <VerticalStackLayout
                BindableLayout.ItemsSource="{Binding ItemGroups}"
                Spacing="12">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:WishItemRankGroupDisplayItem">
                        <VerticalStackLayout Spacing="6">
                            <Label FontAttributes="Bold" FontSize="17" Text="{Binding Name}" />
                            <FlexLayout
                                BindableLayout.ItemsSource="{Binding Items}"
                                Direction="Row"
                                JustifyContent="Start"
                                Wrap="Wrap">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:WishItemStatisticsDisplayItem">
                                        <Border Margin="4" Padding="8" WidthRequest="132">
                                            <Grid RowDefinitions="90,Auto,Auto">
                                                <Grid>
                                                    <Image Aspect="AspectFit" Source="{Binding IconUrl}" />
                                                    <Label
                                                        Margin="0,3,3,0"
                                                        BackgroundColor="#CC333333"
                                                        FontAttributes="Bold"
                                                        HorizontalOptions="End"
                                                        Padding="5,2"
                                                        Text="{Binding Count}"
                                                        TextColor="White"
                                                        VerticalOptions="Start" />
                                                </Grid>
                                                <Label Grid.Row="1" FontAttributes="Bold" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" Text="{Binding ItemName}" />
                                                <Label Grid.Row="2" FontSize="11" HorizontalTextAlignment="Center" Text="{Binding Rank}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>

        <CollectionView
            Grid.Row="1"
            IsVisible="{Binding IsItemListMode}"
            ItemsSource="{Binding ItemStatistics}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:WishItemStatisticsDisplayItem">
                    <Border Margin="0,0,0,8" Padding="10">
                        <Grid ColumnDefinitions="64,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                            <Image Grid.RowSpan="2" Aspect="AspectFit" HeightRequest="56" Source="{Binding IconUrl}" WidthRequest="56" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label FontAttributes="Bold" Text="{Binding ItemName}" />
                                <Label FontSize="11" Text="{Binding Rank}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" FontAttributes="Bold" Text="{Binding Count}" />
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
                                <Button
                                    Clicked="OnToggleTimesClicked"
                                    CommandParameter="{Binding .}"
                                    IsVisible="{Binding CanExpandTimes}"
                                    Text="展开/折叠四星获取时间" />
                                <Label FontSize="11" IsVisible="{Binding IsTimesVisible}" Text="{Binding Times}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentView>
