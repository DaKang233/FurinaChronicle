<ContentView
    x:Class="FurinaChronicle.App.UI.Gacha.ArchiveOverviewView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:FurinaChronicle.App.ViewModels"
    x:DataType="viewModels:GachaAnalysisViewModel">

    <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <Label FontAttributes="Bold" FontSize="20" Text="档案数据总览" />

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding ArchiveOverviewRows}"
            SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Padding="16" HorizontalTextAlignment="Center" Text="当前档案范围暂无可统计的抽卡记录。" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:ArchiveOverviewDisplayRow">
                    <Grid>
                        <Border
                            Margin="0,8,0,4"
                            Padding="14"
                            IsVisible="{Binding IsSummary}">
                            <VerticalStackLayout Spacing="7">
                                <Label FontAttributes="Bold" FontSize="19" Text="{Binding PoolName}" />
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="5">
                                    <Label Text="{Binding Total}" />
                                    <Label Grid.Column="1" Text="{Binding AverageFiveStar}" />
                                    <Label Grid.Row="1" Text="{Binding Extremes}" />
                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding CurrentPity}" />
                                    <Label Grid.Row="2" Grid.ColumnSpan="2" FontSize="12" Text="{Binding RankDistribution}" />
                                </Grid>
                                <Label FontSize="12" Text="{Binding Period}" />
                                <Label FontSize="12" Text="{Binding AverageUp}" TextColor="{AppThemeBinding Light=#666666, Dark=#BBBBBB}" />
                            </VerticalStackLayout>
                        </Border>

                        <HorizontalStackLayout
                            Margin="14,2"
                            BindableLayout.ItemsSource="{Binding Items}"
                            IsVisible="{Binding IsItemRow}"
                            Spacing="3">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:WishPoolItemCountDisplayItem">
                                    <VerticalStackLayout Margin="3" WidthRequest="72" Spacing="2">
                                        <Border HeightRequest="56" Padding="2" WidthRequest="56">
                                            <Grid>
                                                <Image Aspect="AspectFit" Source="{Binding IconUrl}" />
                                                <Label
                                                    BackgroundColor="#CC333333"
                                                    FontAttributes="Bold"
                                                    HorizontalOptions="End"
                                                    Padding="4,1"
                                                    Text="{Binding Count}"
                                                    TextColor="White"
                                                    VerticalOptions="Start" />
                                            </Grid>
                                        </Border>
                                        <Label FontSize="10" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" Text="{Binding ItemName}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentView>
