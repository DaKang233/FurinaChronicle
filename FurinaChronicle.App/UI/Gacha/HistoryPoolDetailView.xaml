<ContentView
    x:Class="FurinaChronicle.App.UI.Gacha.HistoryPoolDetailView"
    x:Name="DetailRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:gacha="clr-namespace:FurinaChronicle.App.UI.Gacha"
    xmlns:viewModels="clr-namespace:FurinaChronicle.App.ViewModels"
    x:DataType="viewModels:GachaHistoryDisplayItem">

    <ContentView.Resources>
        <DataTemplate
            x:Key="ObtainedItemTemplate"
            x:DataType="viewModels:GachaHistoryItemDisplayItem">
            <gacha:GachaItemIconView
                CardWidth="82"
                CountText="{Binding Count}"
                IconSize="64"
                IconSource="{Binding IconUrl}"
                ItemName="{Binding ItemName}"
                Margin="4"
                RankType="{Binding RankType}"
                ShowDetailText="False" />
        </DataTemplate>
    </ContentView.Resources>

    <ScrollView VerticalScrollBarVisibility="Default">
        <VerticalStackLayout Padding="18,16" Spacing="14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="3">
                    <Label
                        FontAttributes="Bold"
                        FontSize="22"
                        Text="{Binding Version}" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        LineBreakMode="WordWrap"
                        Text="{Binding Title}" />
                    <Label FontSize="11" Text="{Binding Period}" TextColor="Gray" />
                </VerticalStackLayout>
                <Border
                    Grid.Column="1"
                    Padding="10,4"
                    StrokeShape="RoundRectangle 12">
                    <Label FontAttributes="Bold" Text="{Binding Total}" />
                </Border>
            </Grid>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Label FontAttributes="Bold" Text="{Binding Pool}" />
                <Label
                    Grid.Column="1"
                    FontSize="11"
                    HorizontalTextAlignment="End"
                    Text="{Binding Accounts}" />
            </Grid>

            <ScrollView
                HorizontalScrollBarVisibility="Default"
                Orientation="Horizontal">
                <HorizontalStackLayout
                    BindableLayout.ItemsSource="{Binding Banners}"
                    Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:GachaHistoryBannerDisplayItem">
                            <Border Padding="8" WidthRequest="300">
                                <VerticalStackLayout Spacing="4">
                                    <Image
                                        Aspect="AspectFit"
                                        HeightRequest="150"
                                        IsVisible="{Binding HasBannerImage}"
                                        Source="{Binding BannerImage}"
                                        WidthRequest="284" />
                                    <Label FontAttributes="Bold" Text="{Binding Name}" />
                                    <Label FontSize="11" Text="{Binding Type}" />
                                    <Label FontSize="11" Text="{Binding FeaturedItems}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <Label
                FontSize="12"
                IsVisible="{Binding IsTextMode, Source={x:Reference DetailRoot}}"
                LineBreakMode="WordWrap"
                Text="{Binding ItemsText}" />

            <VerticalStackLayout
                IsVisible="{Binding IsIconMode, Source={x:Reference DetailRoot}}"
                Spacing="12">
                <VerticalStackLayout IsVisible="{Binding HasFiveStarItems}" Spacing="6">
                    <Label FontAttributes="Bold" FontSize="15" Text="五星物品" />
                    <FlexLayout
                        AlignItems="Start"
                        BindableLayout.ItemTemplate="{StaticResource ObtainedItemTemplate}"
                        BindableLayout.ItemsSource="{Binding FiveStarItems}"
                        Direction="Row"
                        JustifyContent="Start"
                        Wrap="Wrap" />
                </VerticalStackLayout>
                <VerticalStackLayout IsVisible="{Binding HasFourStarItems}" Spacing="6">
                    <Label FontAttributes="Bold" FontSize="15" Text="四星物品" />
                    <FlexLayout
                        AlignItems="Start"
                        BindableLayout.ItemTemplate="{StaticResource ObtainedItemTemplate}"
                        BindableLayout.ItemsSource="{Binding FourStarItems}"
                        Direction="Row"
                        JustifyContent="Start"
                        Wrap="Wrap" />
                </VerticalStackLayout>
                <VerticalStackLayout IsVisible="{Binding HasThreeStarItems}" Spacing="6">
                    <Label FontAttributes="Bold" FontSize="15" Text="三星物品" />
                    <FlexLayout
                        AlignItems="Start"
                        BindableLayout.ItemTemplate="{StaticResource ObtainedItemTemplate}"
                        BindableLayout.ItemsSource="{Binding ThreeStarItems}"
                        Direction="Row"
                        JustifyContent="Start"
                        Wrap="Wrap" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <Label
                FontSize="10"
                LineBreakMode="WordWrap"
                Text="{Binding MetadataNote}"
                TextColor="Gray" />
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
