<ContentView
    x:Class="FurinaChronicle.App.UI.Gacha.HistoryView"
    x:Name="HistoryRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:FurinaChronicle.App.ViewModels"
    x:DataType="viewModels:GachaAnalysisViewModel">

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Label FontAttributes="Bold" FontSize="20" Text="抽卡历史" />
            <ScrollView
                Grid.Column="1"
                HorizontalScrollBarVisibility="Default"
                Orientation="Horizontal">
                <HorizontalStackLayout Spacing="8">
                    <Button
                        Command="{Binding PreloadGachaBannerImagesCommand}"
                        IsEnabled="{Binding CanManageBannerCache}"
                        Text="预下载全部卡池图片" />
                    <Button
                        Command="{Binding ClearGachaBannerImagesCommand}"
                        IsEnabled="{Binding CanManageBannerCache}"
                        Text="清除卡池图片缓存" />
                    <Label Text="文本" VerticalTextAlignment="Center" />
                    <Switch IsToggled="{Binding IsHistoryIconMode}" />
                    <Label Text="图标" VerticalTextAlignment="Center" />
                    <ActivityIndicator
                        IsRunning="{Binding IsBannerCacheBusy}"
                        IsVisible="{Binding IsBannerCacheBusy}" />
                </HorizontalStackLayout>
            </ScrollView>
        </Grid>

        <Label
            Grid.Row="1"
            FontSize="11"
            Text="{Binding BannerCacheStatus}"
            TextColor="Gray" />

        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{OnPlatform WinUI=180, Default=112}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <CollectionView
                x:Name="HistoryVersionList"
                IsEnabled="{Binding CanManageBannerCache}"
                ItemsSource="{Binding HistoryVersions}"
                SelectedItem="{Binding SelectedHistoryVersion, Mode=TwoWay}"
                SelectionChangedCommand="{Binding SelectHistoryVersionCommand}"
                SelectionChangedCommandParameter="{Binding SelectedItem, Source={x:Reference HistoryVersionList}}"
                SelectionMode="Single">
                <CollectionView.EmptyView>
                    <Label Padding="8" Text="当前账号区服没有可用的限定卡池元数据。" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:GachaHistoryVersionOption">
                        <Border Margin="0,0,0,6" Padding="10,8">
                            <Label
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                Text="{Binding DisplayName}" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <CollectionView
                Grid.Column="1"
                ItemsSource="{Binding HistoryItems}"
                SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Padding="16" Text="请选择左侧版本查看当期限定卡池。" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:GachaHistoryDisplayItem">
                        <Border Margin="0,0,0,10" Padding="14">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding Title}" />
                                    <Label
                                        Grid.Column="1"
                                        FontAttributes="Bold"
                                        Text="{Binding Total}" />
                                </Grid>
                                <Label FontSize="12" Text="{Binding Period}" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Label FontAttributes="Bold" Text="{Binding Pool}" />
                                    <Label
                                        Grid.Column="1"
                                        FontSize="11"
                                        HorizontalTextAlignment="End"
                                        Text="{Binding Accounts}" />
                                </Grid>
                                <ScrollView
                                    HorizontalScrollBarVisibility="Default"
                                    Orientation="Horizontal">
                                    <HorizontalStackLayout
                                        BindableLayout.ItemsSource="{Binding Banners}"
                                        Spacing="8">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:GachaHistoryBannerDisplayItem">
                                                <Border Padding="8" WidthRequest="260">
                                                    <VerticalStackLayout Spacing="4">
                                                        <Image
                                                            Aspect="AspectFit"
                                                            HeightRequest="110"
                                                            IsVisible="{Binding HasBannerImage}"
                                                            Source="{Binding BannerImage}"
                                                            WidthRequest="240" />
                                                        <Label FontAttributes="Bold" Text="{Binding Name}" />
                                                        <Label FontSize="11" Text="{Binding Type}" />
                                                        <Label FontSize="11" Text="{Binding FeaturedItems}" />
                                                    </VerticalStackLayout>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </HorizontalStackLayout>
                                </ScrollView>

                                <Label
                                    FontSize="12"
                                    IsVisible="{Binding BindingContext.IsHistoryTextMode, Source={x:Reference HistoryRoot}}"
                                    LineBreakMode="WordWrap"
                                    Text="{Binding ItemsText}" />
                                <FlexLayout
                                    AlignItems="Start"
                                    BindableLayout.ItemsSource="{Binding ItemIcons}"
                                    Direction="Row"
                                    IsVisible="{Binding BindingContext.IsHistoryIconMode, Source={x:Reference HistoryRoot}}"
                                    JustifyContent="Start"
                                    Wrap="Wrap">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:GachaHistoryItemDisplayItem">
                                            <Border Margin="4" Padding="5" WidthRequest="72">
                                                <Grid HeightRequest="62">
                                                    <Image Aspect="AspectFit" Source="{Binding IconUrl}" />
                                                    <Label
                                                        Margin="0,2,2,0"
                                                        BackgroundColor="#CC333333"
                                                        FontAttributes="Bold"
                                                        HorizontalOptions="End"
                                                        Padding="4,1"
                                                        Text="{Binding Count}"
                                                        TextColor="White"
                                                        VerticalOptions="Start" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                                <Label
                                    FontSize="10"
                                    LineBreakMode="WordWrap"
                                    Text="{Binding MetadataNote}"
                                    TextColor="Gray" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentView>
