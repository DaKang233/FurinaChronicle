<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="FurinaChronicle.App.StartupPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:FurinaChronicle.App.ViewModels"
    x:DataType="viewModels:StartupPageViewModel"
    Shell.NavBarIsVisible="False">

    <Grid Padding="32">
        <VerticalStackLayout
            HorizontalOptions="Center"
            MaximumWidthRequest="480"
            Spacing="16"
            VerticalOptions="Center">

            <Label
                FontAttributes="Bold"
                FontSize="26"
                HorizontalTextAlignment="Center"
                Text="FurinaChronicle" />

            <ActivityIndicator
                IsRunning="{Binding IsInitializing}"
                IsVisible="{Binding IsInitializing}" />

            <Label
                HorizontalTextAlignment="Center"
                Text="{Binding StatusMessage}" />

            <Label
                HorizontalTextAlignment="Center"
                IsVisible="{Binding IsFailed}"
                LineBreakMode="WordWrap"
                Text="{Binding ErrorMessage}"
                TextColor="Red" />

        </VerticalStackLayout>
    </Grid>
</ContentPage>