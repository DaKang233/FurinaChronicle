<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="FurinaArchive.App.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:FurinaArchive.App.ViewModels"
    xmlns:core="clr-namespace:FurinaArchive.Core.Wishes;assembly=FurinaArchive.Core"
    x:DataType="viewModels:MainPageViewModel"
    Title="FurinaArchive">

    <Grid
        Padding="24"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="16">

        <Button
            Text="加载模拟祈愿记录"
            Command="{Binding LoadCommand}" />

        <Label
            Grid.Row="1"
            Text="{Binding ErrorMessage}"
            TextColor="Red" />

        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding WishRecords}">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="core:WishRecord">

                    <Grid
                        Padding="12"
                        ColumnDefinitions="*,Auto,Auto"
                        ColumnSpacing="16">

                        <Label
                            FontAttributes="Bold"
                            Text="{Binding ItemName}" />

                        <Label
                            Grid.Column="1"
                            Text="{Binding RankType, StringFormat='{}{0} 星'}" />

                        <Label
                            Grid.Column="2"
                            Text="{Binding Time, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />

                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </Grid>

</ContentPage>